---
/**
 * zhic.me v2 — long-page voxel × terminal site (M1, Figma "Home — Voxel / 1440").
 * Every fact comes from content/ via src/lib/page-data.ts; sections only lay it out.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/sections/About.astro';
import Background from '../components/sections/Background.astro';
import Contact from '../components/sections/Contact.astro';
import Experience from '../components/sections/Experience.astro';
import Footer from '../components/sections/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Nav from '../components/sections/Nav.astro';
import PrefsWindow from '../components/sections/PrefsWindow.astro';
import Projects from '../components/sections/Projects.astro';
import Ticker from '../components/sections/Ticker.astro';
import { getPageData } from '../lib/page-data';

const data = await getPageData();
---

<BaseLayout>
  <div class="page">
    <Background />
    <Nav data={data} />
    <main id="main">
      <Hero data={data} />
      <Ticker data={data} />
      <About data={data} />
      <Projects data={data} />
      <Experience data={data} />
      <Contact data={data} />
    </main>
    <Footer data={data} />
  </div>
  <PrefsWindow copy={data.copy} />
</BaseLayout>

<script>
  import '../scripts/main';
</script>

<style>
  .page {
    position: relative;
    overflow-x: clip;
  }
</style>
