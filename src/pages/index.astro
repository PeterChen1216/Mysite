---
/**
 * M0 plain page: every migrated fact rendered from content/, semantic and zero-JS.
 * Visual design per Figma "Home — Voxel / 1440" lands in M1; this page is the content contract.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAviation,
  getCommunity,
  getEducation,
  getExperience,
  getHonors,
  getInterests,
  getProfile,
  getProjects,
  getProse,
  getSite,
  getSkills,
  render,
} from '../lib/content';
import { contentStamp, formatVersion } from '../lib/build-info';
import { copyrightYears, formatRange, formatYearMonth } from '../lib/format';
import { withBase } from '../lib/paths';
import type { Project } from '../content/schema';

const [
  site,
  profile,
  education,
  experience,
  community,
  honors,
  interests,
  skills,
  aviation,
  projects,
  about,
  now,
] = await Promise.all([
  getSite(),
  getProfile(),
  getEducation(),
  getExperience(),
  getCommunity(),
  getHonors(),
  getInterests(),
  getSkills(),
  getAviation(),
  getProjects(),
  getProse('about'),
  getProse('now'),
]);

const renderedProjects = await Promise.all(
  projects.map(async (p) => ({ id: p.id, data: p.data, Body: (await render(p)).Content })),
);

const publicEmails = profile.emails.filter((e) => e.public);
const primaryEmail = profile.emails.find((e) => e.primary)!;
const stamp = contentStamp();
const version = formatVersion(site.version, stamp);
const resumeHref = withBase('resume.pdf');
const PLATFORM_LABEL: Record<Project['platform'][number], string> = {
  ios: 'iOS',
  web: 'Web',
  cli: 'CLI',
  research: 'Research',
};
const STATUS_LABEL: Record<Project['status'], string> = {
  idea: 'idea',
  wip: 'in progress',
  testflight: 'TestFlight',
  shipped: 'shipped',
  completed: 'completed',
  archived: 'archived',
};
const hasAvgeek =
  aviation.watching.length +
    aviation.seat_rules.length +
    aviation.favorite_cabins.length +
    aviation.news.length +
    aviation.fare_examples.length +
    aviation.tools.length >
  0;
---

<BaseLayout>
  <header class="site-header">
    <nav aria-label="Sections">
      <ul>
        <li>
          <a href="#about">About</a>
        </li>
        <li>
          <a href="#education">Education</a>
        </li>
        <li>
          <a href="#honors">Honors</a>
        </li>
        <li>
          <a href="#projects">Projects</a>
        </li>
        <li>
          <a href="#experience">Experience</a>
        </li>
        {community.length > 0 && (
          <li>
            <a href="#community">Community</a>
          </li>
        )}
        <li>
          <a href="#skills">Skills</a>
        </li>
        {hasAvgeek && (
          <li>
            <a href="#avgeek">AvGeek</a>
          </li>
        )}
        <li>
          <a href="#contact">Contact</a>
        </li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="name">
      <Image
        src={profile.avatar}
        alt={profile.avatar_alt}
        width={160}
        height={160}
        widths={[160, 320]}
        sizes="160px"
        class="avatar"
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <p class="prompt" aria-hidden="true">
          $ whoami
        </p>
        <h1 id="name">{profile.name.display}</h1>
        <p class="full-name">{profile.name.full}</p>
        <p class="tagline">{profile.tagline}</p>
        <p class="meta">
          {profile.location} · <span class="status">{profile.status}</span>
        </p>
        <ul class="links" aria-label="Links">
          <li>
            <a href={`mailto:${primaryEmail.address}`}>{primaryEmail.address}</a>
          </li>
          {profile.socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))}
          <li>
            <a href={resumeHref} target="_blank" rel="noopener">
              Résumé (PDF)
            </a>
          </li>
        </ul>
      </div>
    </section>

    {now.Content && (
      <section aria-labelledby="now-title">
        <h2 id="now-title">Now</h2>
        <now.Content />
      </section>
    )}

    <section id="about" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      {about.Content && <about.Content />}
      <h3>Interests</h3>
      <ul>
        {interests.items.map((i) => (
          <li>
            {i.name}
            {i.note && <> — {i.note}</>}
          </li>
        ))}
      </ul>
    </section>

    <section id="education" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      {education.map((e) => (
        <article>
          <h3>{e.url ? <a href={e.url}>{e.school}</a> : e.school}</h3>
          <p>
            {e.degree}
            {e.track && <>, {e.track} track</>}
            {e.minor && <>, Minor in {e.minor}</>}
            {e.department && (
              <>
                {' '}
                · {e.department_url ? <a href={e.department_url}>{e.department}</a> : e.department}
              </>
            )}
          </p>
          <p class="dates">
            {formatYearMonth(e.start)} – {formatYearMonth(e.end)}
            {e.expected && ' (expected)'}
          </p>
          {e.gpa && (
            <p>
              {e.gpa_label}: {e.gpa}
            </p>
          )}
          {e.honors.length > 0 && (
            <ul>
              {e.honors.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          {e.coursework.length > 0 && (
            <>
              <h4>Relevant coursework</h4>
              <ul class="inline-list">
                {e.coursework.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))}
    </section>

    <section id="honors" aria-labelledby="honors-title">
      <h2 id="honors-title">Honors &amp; Awards</h2>
      <ul>
        {honors.map((h) => (
          <li>
            {h.name}, {h.org}, {h.year}
            {h.note && <> — {h.note}</>}
          </li>
        ))}
      </ul>
    </section>

    <section id="projects" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      {renderedProjects.map(({ id, data, Body }) => (
        <article id={`project-${id}`}>
          {data.icon && (
            <Image src={data.icon} alt="" width={48} height={48} class="project-icon" />
          )}
          <h3>{data.title}</h3>
          {data.tagline && <p>{data.tagline}</p>}
          {data.cover && (
            <Image src={data.cover} alt={data.cover_alt ?? ''} width={640} class="project-cover" />
          )}
          <p class="meta">
            {data.year} · {data.platform.map((p) => PLATFORM_LABEL[p]).join(', ')} ·{' '}
            {STATUS_LABEL[data.status]}
          </p>
          {(data.role || data.location || data.start) && (
            <p class="meta">
              {[
                data.role,
                data.location,
                data.start && data.end && formatRange(data.start, data.end),
              ]
                .filter(Boolean)
                .join(' · ')}
            </p>
          )}
          {data.stack.length > 0 && <p class="meta">Stack: {data.stack.join(', ')}</p>}
          <Body />
          {data.links &&
            (data.links.live ||
              data.links.repo ||
              data.links.appstore ||
              data.links.other.length > 0) && (
              <ul class="links">
                {data.links.live && (
                  <li>
                    <a href={data.links.live}>Live site</a>
                  </li>
                )}
                {data.links.repo && (
                  <li>
                    <a href={data.links.repo}>Source code</a>
                  </li>
                )}
                {data.links.appstore && (
                  <li>
                    <a href={data.links.appstore}>App Store</a>
                  </li>
                )}
                {data.links.other.map((l) => (
                  <li>
                    <a href={l.url}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
        </article>
      ))}
    </section>

    <section id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      {experience.map((x) => (
        <article>
          <h3>
            {x.logo && <Image src={x.logo} alt="" width={24} height={24} class="logo" />}
            {x.role} @ {x.url ? <a href={x.url}>{x.company}</a> : x.company}, {x.location}
          </h3>
          <p class="dates">{formatRange(x.start, x.end)}</p>
          <ul>
            {x.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    {community.length > 0 && (
      <section id="community" aria-labelledby="community-title">
        <h2 id="community-title">Community</h2>
        {community.map((x) => (
          <article>
            <h3>
              {x.logo && <Image src={x.logo} alt="" width={24} height={24} class="logo" />}
              {x.role} @ {x.url ? <a href={x.url}>{x.company}</a> : x.company}, {x.location}
            </h3>
            <p class="dates">{formatRange(x.start, x.end)}</p>
            <ul>
              {x.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    )}

    <section id="skills" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills</h2>
      <dl class="skills">
        {skills.groups.map((g) => (
          <>
            <dt>{g.name}</dt>
            <dd>
              {g.items.join(', ')}
              {g.basic.length > 0 && `; basic ${g.basic.join(', ')}`}
            </dd>
          </>
        ))}
      </dl>
    </section>

    {hasAvgeek && (
      <section id="avgeek" aria-labelledby="avgeek-title">
        <h2 id="avgeek-title">AvGeek</h2>
        {aviation.watching.length > 0 && (
          <>
            <h3>Watching</h3>
            <ul>
              {aviation.watching.map((r) => (
                <li>
                  {r.from} → {r.to} · {r.airline} {r.aircraft} — {r.why}
                </li>
              ))}
            </ul>
          </>
        )}
        {aviation.seat_rules.length > 0 && (
          <>
            <h3>Seat rules</h3>
            <ul>
              {aviation.seat_rules.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </>
        )}
        {aviation.favorite_cabins.length > 0 && (
          <>
            <h3>Favorite cabins</h3>
            <ul>
              {aviation.favorite_cabins.map((c) => (
                <li>
                  {c.aircraft} · {c.cabin} — {c.why}
                </li>
              ))}
            </ul>
          </>
        )}
        {aviation.news.length > 0 && (
          <>
            <h3>Route news</h3>
            <ul>
              {aviation.news.map((n) => (
                <li>
                  <time datetime={n.date}>{n.date}</time> <a href={n.url}>{n.headline}</a>
                </li>
              ))}
            </ul>
          </>
        )}
        {aviation.fare_examples.length > 0 && (
          <>
            <h3>Fare lab</h3>
            <ul>
              {aviation.fare_examples.map((f) => (
                <li>
                  <code>{f.code}</code> {f.route} — {f.notes}
                </li>
              ))}
            </ul>
          </>
        )}
        {aviation.tools.length > 0 && (
          <>
            <h3>Tools I use</h3>
            <ul class="inline-list">
              {aviation.tools.map((t) => (
                <li>
                  <a href={t.url} rel="noopener" target="_blank">
                    {t.name}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    <section id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <ul class="links">
        {publicEmails.map((e) => (
          <li>
            <a href={`mailto:${e.address}`}>{e.address}</a>
          </li>
        ))}
        {profile.socials.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <p>
      Last updated <time datetime={stamp.date}>{stamp.date}</time>
      {site.footer.update_note && <> · {site.footer.update_note}</>}
    </p>
    <p>
      {copyrightYears(site.footer.copyright_start, new Date().getFullYear())}{' '}
      {site.footer.copyright_holder}. All rights reserved. · <span class="version">{version}</span>
    </p>
  </footer>
</BaseLayout>

<style>
  .site-header,
  main,
  .site-footer {
    max-width: 880px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  /* The nav uses the monospace body font, whose width matches its fallback, so the line breaks
     are the same before and after the web font loads (the 8-bit font is ~1.7× wider than its
     fallback and made the wrapped nav grow → CLS 0.28). M1 replaces this nav. */
  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0;
    font: var(--type-code-sm);
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-8);
  }
  .avatar {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border: 4px solid var(--color-border-edge);
    box-shadow: var(--shadow-hard);
  }
  .prompt {
    margin: 0;
    font: var(--type-term-lg);
    color: var(--color-accent-terminal-green);
  }
  h1 {
    margin: 0;
    font: var(--type-pixel-h2);
    letter-spacing: var(--type-pixel-h2-tracking);
  }
  h2 {
    font: var(--type-pixel-h3);
    margin-block: var(--space-12) var(--space-4);
    border-bottom: 2px solid var(--color-border-line);
    padding-bottom: var(--space-2);
  }
  h3 {
    font: var(--type-pixel-h4);
    margin-block: var(--space-6) var(--space-2);
  }
  h4 {
    font: var(--type-code-label);
    letter-spacing: var(--type-code-label-tracking);
    text-transform: uppercase;
    color: var(--color-text-mid);
  }
  .full-name,
  .tagline,
  .meta,
  .dates {
    margin: var(--space-1) 0;
    color: var(--color-text-mid);
  }
  .status {
    color: var(--color-accent-terminal-green);
  }
  .links,
  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
  }
  .inline-list li::after {
    content: ' ·';
    color: var(--color-text-mid);
  }
  .inline-list li:last-child::after {
    content: '';
  }
  .project-icon {
    display: block;
    image-rendering: pixelated;
  }
  .project-cover {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    border: 2px solid var(--color-border-edge);
  }
  /* Logos are decorative (alt=""): the company name is the adjacent text. */
  .logo {
    display: inline-block;
    vertical-align: -4px;
    margin-right: var(--space-2);
  }
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }
  .skills dt {
    font: var(--type-code-bold);
  }
  .skills dd {
    margin: 0;
  }
  @media (max-width: 480px) {
    .skills {
      grid-template-columns: 1fr;
    }
    .skills dd {
      margin-bottom: var(--space-2);
    }
  }
  .site-footer {
    margin-top: var(--space-16);
    padding-block: var(--space-8);
    border-top: 2px solid var(--color-border-line);
    font: var(--type-code-sm);
    color: var(--color-text-mid);
  }
  @media (max-width: 480px) {
    h1 {
      font: var(--type-pixel-h3);
    }
  }
</style>
