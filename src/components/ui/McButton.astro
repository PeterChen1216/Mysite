---
/**
 * Minecraft-style button (Figma component MCButton, node 15:733): Stone (neutral) / Grass (primary).
 * Hover = classic blue/yellow highlight in 3 steps over 120 ms (PLAN §5.2).
 * Colours are darkened slightly from Figma to meet WCAG AA (white on Figma's grass #5d9c3a is
 * 3.2:1, yellow on its hover blue #7b8dff 2.9:1); see docs/M1-PLAN.md §4.
 */
interface Props {
  href: string;
  kind?: 'stone' | 'grass';
  external?: boolean;
  download?: boolean;
  class?: string;
  /** Accessible name when the visible label is cryptic. */
  ariaLabel?: string;
}
const { href, kind = 'stone', external = false, download = false, class: cls, ariaLabel } = Astro.props;
---

<a
  class:list={['mc-btn', `mc-btn--${kind}`, cls]}
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
  {...download ? { download: '' } : {}}
  {...ariaLabel ? { 'aria-label': ariaLabel } : {}}
  data-particles
><span class="mc-btn__label"><slot /></span></a>

<style>
  .mc-btn {
    --bg: #6f6f6f;
    --hi: #a8a8a8;
    --lo: #2c2c2c;
    --fg: #fff;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border: 2px solid #000;
    background: var(--bg);
    color: var(--fg);
    font: var(--type-pixel-button);
    letter-spacing: var(--type-pixel-button-tracking);
    text-shadow: 2px 2px 0 #3f3f3f;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 120ms steps(3),
      color 120ms steps(3);
  }
  .mc-btn::before,
  .mc-btn::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    transition: background-color 120ms steps(3);
  }
  .mc-btn::before {
    top: 0;
    height: 3px;
    background: var(--hi);
  }
  .mc-btn::after {
    bottom: 0;
    height: 4px;
    background: var(--lo);
  }
  .mc-btn__label {
    position: relative;
  }
  .mc-btn--grass {
    --bg: #44802a;
    --hi: #8ed35c;
    --lo: #2f5a1c;
  }
  .mc-btn:hover,
  .mc-btn:focus-visible {
    --bg: #4f63e0;
    --hi: #aebbff;
    --lo: #2a3380;
    --fg: #ffffa0;
    color: var(--fg);
  }
  .mc-btn--grass:hover,
  .mc-btn--grass:focus-visible {
    --bg: #3d7a22;
    --hi: #a7e07e;
    --lo: #345f20;
  }
  .mc-btn:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 3px;
  }
  .mc-btn:active {
    transform: translateY(2px);
  }
</style>
