---
/**
 * Floating "enchanted tooltip" badge (Figma "Tooltip"), used on the hero stage.
 * Symbols outside the pixel font's Latin subset (★ ✈ ⇄ →) are drawn in a symbol font so they
 * don't fall back to a tiny default glyph.
 */
interface Props {
  text: string;
  tone?: 'gold' | 'cyan' | 'white';
  class?: string;
  style?: string;
}
const { text, tone = 'white', class: cls, style } = Astro.props;
const parts = text.split(/([★✈⇄→✦])/u).filter(Boolean);
---

<p class:list={['tooltip', `tooltip--${tone}`, cls]} style={style}>
  {parts.map((p) => (/^[★✈⇄→✦]$/u.test(p) ? <span class="sym">{p}</span> : p))}
</p>

<style>
  .tooltip {
    margin: 0;
    padding: 8px 10px;
    border: 2px solid var(--color-tooltip-edge);
    background: var(--color-tooltip-bg-solid);
    font: var(--type-pixel-tiny);
    letter-spacing: var(--type-pixel-tiny-tracking);
    text-shadow: 1px 1px 0 var(--color-tooltip-text-shadow);
    white-space: pre;
  }
  .sym {
    font-family: var(--font-symbol);
    font-size: calc(11px * var(--ts));
    line-height: 1;
  }
  .tooltip--gold {
    color: var(--color-accent-gold);
  }
  .tooltip--cyan {
    color: var(--color-accent-aqua);
  }
  .tooltip--white {
    color: var(--color-paper);
  }
</style>
