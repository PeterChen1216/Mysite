---
/** Floating "enchanted tooltip" badge (Figma "Tooltip"): used on the hero stage. */
interface Props {
  tone?: 'gold' | 'cyan' | 'white';
  class?: string;
  style?: string;
}
const { tone = 'white', class: cls, style } = Astro.props;
---

<p class:list={['tooltip', `tooltip--${tone}`, cls]} style={style}><slot /></p>

<style>
  .tooltip {
    margin: 0;
    padding: 8px 10px;
    border: 2px solid #5000ff;
    background: rgb(16 0 16 / 0.94);
    font: var(--type-pixel-tiny);
    letter-spacing: var(--type-pixel-tiny-tracking);
    text-shadow: 1px 1px 0 #1b1b1b;
    white-space: pre;
  }
  .tooltip--gold {
    color: var(--color-accent-gold);
  }
  .tooltip--cyan {
    color: #55ffff;
  }
  .tooltip--white {
    color: #fff;
  }
</style>
