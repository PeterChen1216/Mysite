---
/**
 * Enchanted-tooltip chip (Figma "Chip"): purple border on near-black, 8-bit label. A dark object
 * (stays dark in the light themes); the tone's glyph (data-cue, global.css) shows outside Night.
 */
import { cueFor } from '../../lib/cues';
interface Props {
  tone?: 'enchant' | 'diamond' | 'cyan' | 'gold' | 'grass' | 'redstone' | 'white';
  as?: 'span' | 'li';
}
const { tone = 'diamond', as: Tag = 'span' } = Astro.props;
---

<Tag class:list={['chip', `chip--${tone}`]} data-surface="dark" data-cue={cueFor(tone)}>
  <slot />
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: flex-start;
    padding: 6px 8px;
    border: 2px solid var(--color-tooltip-edge);
    background: var(--color-tooltip-bg);
    font: var(--type-pixel-tiny);
    letter-spacing: var(--type-pixel-tiny-tracking);
    white-space: nowrap;
  }
  /* Figma's enchant purple is 4.3:1 on this background; the lightened token passes AA. */
  .chip--enchant {
    color: var(--color-accent-enchant-text);
  }
  .chip--diamond {
    color: var(--color-accent-diamond);
  }
  .chip--cyan {
    color: var(--color-accent-aqua);
  }
  .chip--gold {
    color: var(--color-accent-gold);
  }
  .chip--grass {
    color: var(--color-accent-terminal-green);
  }
  .chip--redstone {
    color: var(--color-accent-redstone);
  }
  .chip--white {
    color: var(--color-paper);
  }
</style>
