---
/**
 * Pixel globe, 2.5D strip version (PLAN §5.3/M1; Figma PixelGlobe 15:650): an equirectangular
 * pixel map (648×324 per tile, three tiles) slides behind a pixel-circle mask, so the planet
 * spins with plain CSS — no canvas, no WebGL. One tile = one rotation = LOOP.globeTurnMs (12 s,
 * PLAN §5.2), read from the `--m-globe-*` custom properties (src/motion/params.ts).
 * The script in src/scripts/globe.ts adds hover slow-down, drag-to-spin and off-screen pause;
 * reduced motion keeps it still. The ambient globes are decorative (aria-hidden); the
 * interactive one is a slider for the keyboard (arrow keys turn it, WCAG 2.5.7), named by
 * `label` and reporting how far it has turned through `valueText` ({deg}).
 *
 * No routes or pins are drawn: the design's SEA⇄PVG route was rejected (DECISIONS Q4); routes
 * from content/aviation.yaml `watching` arrive with the AvGeek console.
 */
import land from '../../assets/voxel/globe/land.svg';
import ice from '../../assets/voxel/globe/ice.svg';
import mask from '../../assets/voxel/globe/ocean-mask.svg';
import sheen from '../../assets/voxel/globe/sheen.svg';
import type { HTMLAttributes } from 'astro/types';
import { GLOBE_TILE_PX } from '../../motion/params';

interface Props {
  /** Rendered diameter in px (the design's hero globe is 324). */
  size?: number;
  class?: string;
  style?: string;
  /** Allow drag-to-spin and the arrow keys (hero only); needs `label` and `valueText`. */
  interactive?: boolean;
  /** The slider's accessible name (interactive only). */
  label?: string;
  /** Its value as words; {deg} = degrees turned (interactive only). */
  valueText?: string;
  /**
   * The crosshair's words (interactive only; PLAN-EXPERIENCE §6 row 4, src/scripts/globe-probe.ts):
   * latitude / longitude templates ({deg}) and the continent and ocean names.
   */
  probe?: { lat: object; lon: object; regions: object };
}
const {
  size = 324,
  class: cls,
  style,
  interactive = false,
  label = '',
  valueText = '{deg}',
  probe,
} = Astro.props;
if (interactive && !label) throw new Error('An interactive PixelGlobe needs a label');
const slider: HTMLAttributes<'div'> = interactive
  ? {
      role: 'slider',
      tabindex: 0,
      'aria-label': label,
      'aria-orientation': 'horizontal',
      'aria-valuemin': 0,
      'aria-valuemax': 359,
      'aria-valuenow': 0,
      'aria-valuetext': valueText.replace(/\{\s*deg\s*\}/g, '0'),
      'data-value-text': valueText,
      ...(probe ? { 'data-probe': JSON.stringify(probe) } : {}),
    }
  : { 'aria-hidden': 'true' };
const scale = size / 324;
---

<div
  class:list={['globe', cls]}
  style={`--globe-size:${size}px;--globe-scale:${scale};--mask:url("${mask.src}");${style ?? ''}`}
  {...slider}
  data-globe={interactive ? 'interactive' : 'ambient'}
>
  <div class="globe__inner">
    <div class="globe__ocean"></div>
    <div class="globe__clip">
      <div class="globe__strip" data-globe-strip>
        {[0, 1, 2].map((i) => (
          <>
            <img
              src={land.src}
              width={GLOBE_TILE_PX}
              height="324"
              alt=""
              draggable="false"
              style={`left:${i * GLOBE_TILE_PX}px`}
            />
            <img
              src={ice.src}
              width={GLOBE_TILE_PX}
              height="324"
              alt=""
              draggable="false"
              style={`left:${i * GLOBE_TILE_PX}px`}
            />
          </>
        ))}
      </div>
    </div>
    <div class="globe__shade"></div>
    <img class="globe__sheen" src={sheen.src} width="324" height="324" alt="" draggable="false" />
  </div>
</div>

<style>
  .globe {
    position: relative;
    width: var(--globe-size);
    height: var(--globe-size);
    flex: none;
    touch-action: pan-y;
  }
  .globe[data-globe='interactive'] {
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .globe[data-globe='interactive']:active {
    cursor: grabbing;
  }
  /* High Contrast: the slider keeps a visible boundary (outline: the art's box must not move). */
  @media (forced-colors: active) {
    .globe[role='slider'] {
      outline: 1px solid CanvasText;
      outline-offset: 2px;
    }
  }
  .globe__inner {
    position: absolute;
    left: 0;
    top: 0;
    width: 324px;
    height: 324px;
    transform: scale(var(--globe-scale));
    transform-origin: 0 0;
  }
  .globe__ocean,
  .globe__clip,
  .globe__shade,
  .globe__sheen {
    position: absolute;
    inset: 0;
    width: 324px;
    height: 324px;
    -webkit-mask: var(--mask) 0 0 / 324px 324px no-repeat;
    mask: var(--mask) 0 0 / 324px 324px no-repeat;
  }
  .globe__ocean {
    background: var(--color-block-water);
  }
  .globe__clip {
    overflow: hidden;
  }
  .globe__strip {
    position: absolute;
    top: 0;
    /* Which longitude faces the viewer at rest (art direction). */
    left: -485px;
    width: calc(3 * var(--m-globe-tile, 648px));
    height: 324px;
  }
  /* Spins only when the motion class is set (JS on, no reduced motion) — see src/styles/motion.css. */
  :global(html.motion) .globe__strip {
    animation: globe-spin calc(var(--m-globe-turn) * var(--loop-slow, 1)) linear infinite;
    will-change: transform;
  }
  .globe__strip img {
    position: absolute;
    top: 0;
    width: var(--m-globe-tile, 648px);
    height: 324px;
    max-width: none;
    image-rendering: pixelated;
    /* Mono: white land on a black ocean, or black land on a light one (§3.4). */
    filter: var(--art-land-filter);
  }
  .globe__shade {
    background: radial-gradient(
      circle closest-side,
      var(--color-shade-clear) 0%,
      var(--color-shade-soft) 55%,
      var(--color-shade-deep) 100%
    );
  }
  /* Row 4: the crosshair (in the disc, through the point) and its readout (above the point). Made
     by src/scripts/globe-probe.ts; outside .globe__inner, so it shows over the WebGL Earth too. */
  .globe :global(.globe__probe) {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--mask) 0 0 / 100% 100% no-repeat;
    mask: var(--mask) 0 0 / 100% 100% no-repeat;
    pointer-events: none;
    opacity: 0;
  }
  .globe :global(.globe__probe-h),
  .globe :global(.globe__probe-v) {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--color-accent-gold);
    opacity: 0.85;
  }
  .globe :global(.globe__probe-h) {
    width: 100%;
    height: 2px;
  }
  .globe :global(.globe__probe-v) {
    width: 2px;
    height: 100%;
  }
  .globe :global(.globe__probe-label) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    padding: 6px 8px;
    border: 2px solid var(--color-tooltip-edge);
    background: var(--color-tooltip-bg-solid);
    font: var(--type-pixel-tiny);
    letter-spacing: var(--type-pixel-tiny-tracking);
    color: var(--color-accent-gold);
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - var(--m-cross)));
    /* The hero stage may be drawn smaller (--s); the readout keeps its 8 px type. */
    zoom: calc(1 / var(--s, 1));
    opacity: 0;
  }
  .globe :global(.globe__probe-label[data-side='below']) {
    transform: translate(-50%, var(--m-cross));
  }
  .globe :global(.globe__probe[data-on='true']),
  .globe :global(.globe__probe-label[data-on='true']) {
    opacity: 1;
  }
  @media (forced-colors: active) {
    .globe :global(.globe__probe-h),
    .globe :global(.globe__probe-v) {
      forced-color-adjust: none;
      background: Highlight;
    }
  }
  @keyframes globe-spin {
    from {
      transform: translateX(calc(-1 * var(--m-globe-tile, 648px)));
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.motion) .globe__strip {
      animation: none;
    }
  }
</style>
