---
/**
 * Footer (Figma "Footer"): copyright · domain, tagline, version · last updated, `prefs` (opens the
 * settings window; shown when JavaScript runs), back to top.
 */
import Glyphs from '../ui/Glyphs.astro';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { footer, copy, site } = data;
---

<footer class="foot">
  <p class="foot__left">
    {footer.copyright}. {copy.footer.rights} · {site.domain}
  </p>
  <p class="foot__mid">{copy.footer.tagline}</p>
  <div class="foot__right">
    <p>
      <span class="foot__ver">{footer.version}</span> · {copy.footer.updated}{' '}
      <time datetime={footer.updated}>{footer.updated}</time>
      {site.footer.update_note && <span class="foot__note"> · {site.footer.update_note}</span>}
    </p>
    <button
      type="button"
      class="foot__prefs"
      data-prefs-open
      aria-haspopup="dialog"
      aria-controls="prefs"
    >
      {copy.footer.prefs}
    </button>
    <a class="foot__top" href="#top">
      <Glyphs text={copy.footer.back_to_top} />
    </a>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px 32px;
    padding: 22px var(--gutter);
    background: var(--color-bg-bar);
    border-top: 2px solid var(--color-border-line);
    font: var(--type-code-sm);
    color: var(--color-text-mid);
  }
  .foot__mid {
    text-align: center;
  }
  .foot__right {
    justify-self: end;
    justify-content: flex-end;
    text-align: right;
  }
  .foot p {
    margin: 0;
  }
  .foot__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  .foot__top {
    color: var(--color-accent-terminal-green);
    text-decoration: none;
    white-space: nowrap;
  }
  .foot__top:hover,
  .foot__top:focus-visible,
  .foot__prefs:hover,
  .foot__prefs:focus-visible {
    text-decoration: underline;
  }
  .foot__prefs {
    display: none;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-accent-terminal-green);
    cursor: pointer;
  }
  :global(html.js) .foot__prefs {
    display: inline;
  }
  @media (max-width: 1023px) {
    .foot {
      grid-template-columns: 1fr;
      justify-items: start;
      padding: 28px 32px;
    }
    .foot__mid,
    .foot__right {
      justify-self: start;
      justify-content: flex-start;
      text-align: left;
    }
  }
  @media (max-width: 767px) {
    .foot {
      padding: 24px 16px;
    }
  }
</style>
