---
/**
 * Projects (Figma "Projects" 22:956): section header with a floating Diamond block, the featured
 * build (ProjectFeatured — Card/Featured 22:1020 + PhoneMockup 22:1158), every other project
 * (ProjectCard — Card/ThisSite 22:1203) and the "next chunk" teaser (Card/Next 22:1275).
 * Facts come from content/projects/*.md through PageData; interface text from copy.yaml.
 *
 * Phones (X4; §8.3, Figma "Other builds · snap carousel" 64:13908): the featured card first (its
 * phone centred, with 44 px city keys under it), then the other cards as a carousel — native
 * scroll-snap, 300 px cards with the next one peeking, previous / next keys, position dots and
 * `list all ▸` (the directory). Never moves by itself; every card stays in the Tab order (focus
 * scrolls it into view) and tells screen readers its place ("2 of 3"). It needs JavaScript (its
 * keys and dots); without it the cards stack as on a tablet.
 */
import Glyphs from '../ui/Glyphs.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import { fillTemplate, glyphParts } from '../../lib/derive';
import Card from '../ui/Card.astro';
import CardTitle from '../ui/CardTitle.astro';
import Chip from '../ui/Chip.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import VoxelBlock from '../ui/VoxelBlock.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectFeatured from './ProjectFeatured.astro';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const copy = data.copy.projects;
const { featured } = data;
const others = data.projects.filter((p) => p.id !== featured.id);
// Cards below the featured build, teaser included: pairs sit side by side as in Figma (Row2);
// with three, the first takes both rows of the left column and the other two stack beside it;
// any other odd count closes with the teaser as a full-width strip.
const cards = others.length + 1;
const layout = cards === 3 ? 'stack' : cards % 2 === 1 ? 'strip' : 'pairs';
/** "2 of 3": a card's place in the phone's carousel (read out only there). */
const position = (n: number) =>
  fillTemplate(
    copy.position,
    { n: String(n), count: String(cards) },
    [],
    'copy.yaml projects.position',
  );
const w = data.copy.windows;
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <span class="projects__diamond" aria-hidden="true">
    <VoxelBlock name="diamond" size={55} />
  </span>
  <SectionHeader
    id="projects-title"
    cmd={copy.cmd}
    title={copy.title}
    blurb={copy.blurb}
    more={{
      href: data.paths.projects,
      text: data.copy.windows.more,
      label: data.copy.windows.more_label,
      window: 'directory-window',
    }}
  />
  <ProjectFeatured
    project={featured}
    copy={copy}
    labels={data.copy.labels}
    href={data.paths.project(featured.id)}
  />
  <div
    class="projects__grid"
    id="projects-carousel"
    data-layout={layout}
    data-carousel
    data-carousel-label={w.neighbours_label}
    data-snap-row
  >
    {others.map((p, i) => (
      <ProjectCard
        project={p}
        copy={copy}
        labels={data.copy.labels}
        href={data.paths.project(p.id)}
        position={position(i + 1)}
      />
    ))}
    <Card as="article" dashed class="pc pc--next" labelledby="projects-next-title">
      <p class="pc__pos">{position(cards)}</p>
      <span class="next__block" aria-hidden="true">
        <VoxelBlock name="tnt" size={69} />
      </span>
      <CardTitle label={copy.next_label} />
      <h3 class="next__title" id="projects-next-title">
        {copy.next_title}
      </h3>
      <p class="next__body">{copy.next_body}</p>
      <div class="next__foot">
        {copy.next_tags.length > 0 && (
          <ul class="next__tags">
            {copy.next_tags.map((tag) => (
              <Chip as="li" tone="enchant">
                {tag}
              </Chip>
            ))}
          </ul>
        )}
        <p class="next__progress">
          <span class="next__spin" aria-hidden="true">
            [ <span data-loop="blink">/</span> ]
          </span>
          {copy.next_progress}
        </p>
      </div>
    </Card>
  </div>
  <div class="carousel" data-carousel-keys="projects-carousel">
    <button
      type="button"
      class="carousel__key"
      data-carousel-step="-1"
      aria-controls="projects-carousel"
    >
      <PixelIcon name="tri-left" size={14} />
      <span class="visually-hidden">{glyphParts(w.prev).text}</span>
    </button>
    <span class="carousel__dots" aria-hidden="true">
      {Array.from({ length: cards }, (_, i) => (
        <i data-on={i === 0 ? '' : undefined} />
      ))}
    </span>
    <button
      type="button"
      class="carousel__key"
      data-carousel-step="1"
      aria-controls="projects-carousel"
    >
      <PixelIcon name="tri-right" size={14} />
      <span class="visually-hidden">{glyphParts(w.next).text}</span>
    </button>
    <a class="carousel__all" href={data.paths.projects} data-window-open="directory-window">
      <Glyphs text={copy.list_all} />
    </a>
  </div>
</section>

<style>
  .projects {
    /* A lifted card's edge takes the section's accent (ui/Card.astro); the teaser its own. */
    --card-accent: var(--color-accent-gold);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 120px var(--gutter) 48px;
  }
  /* Figma: left 1150 / top 40 in the 1440 frame → anchored to the right edge. */
  .projects__diamond {
    position: absolute;
    top: 40px;
    right: 235px;
    filter: drop-shadow(0 0 11.2px var(--color-glow-diamond));
  }

  /* Card roots are rendered by ui/Card.astro, hence :global(). */
  .projects :global(.pf) {
    flex-direction: row;
    align-items: center;
    gap: 48px;
    padding: 40px;
    overflow: clip;
  }
  .projects :global(.pc) {
    gap: 18px;
    padding: 28px;
    overflow: clip;
  }
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .projects__grid[data-layout='stack'] > :global(:first-child) {
    grid-row: span 2;
  }
  .projects__grid[data-layout='strip'] > :global(.pc--next) {
    grid-column: 1 / -1;
  }
  .projects__grid[data-layout='strip'] .next__foot {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  /* "next chunk" teaser */
  .projects :global(.pc--next) {
    --card-accent: var(--color-accent-enchant);
  }
  .next__block {
    position: absolute;
    top: -10px;
    right: 75px;
  }
  .next__title {
    margin: 0;
    font: var(--type-pixel-h4);
    letter-spacing: var(--type-pixel-h4-tracking);
    /* Figma uses text/lo (3.0:1); text/mid keeps it readable (WCAG AA). */
    color: var(--color-text-mid);
  }
  .next__body {
    margin: 0;
    max-width: 560px;
    font: var(--type-code-body);
    color: var(--color-text-mid);
  }
  .next__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .next__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .next__progress {
    margin: 0;
    font: var(--type-term-md);
    color: var(--color-text-mid);
  }
  .next__spin {
    margin-right: 0.3em;
    color: var(--color-accent-gold);
    white-space: nowrap;
  }

  @media (max-width: 1279px) {
    .projects {
      padding-inline: 32px;
    }
  }
  @media (max-width: 1023px) {
    .projects :global(.pf) {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }
    .projects__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .projects__grid[data-layout='stack'] > :global(:first-child) {
      grid-row: auto;
    }
  }
  @media (max-width: 767px) {
    .projects {
      gap: 32px;
      padding: 88px 16px 40px;
    }
    .projects__diamond {
      top: 24px;
      right: 24px;
    }
    .projects :global(.pf) {
      padding: 32px 20px;
    }
    .projects :global(.pc) {
      padding: 22px 20px;
    }
    .next__block {
      right: 16px;
    }
    .next__block :global(.voxel) {
      width: 56px;
      height: auto;
    }
  }

  /* The carousel's parts: phones with JavaScript only. A card's place is read out there only. */
  .carousel,
  .projects :global(.pc__pos) {
    display: none;
  }
  @media (max-width: 767px) {
    .projects :global(.pc__pos) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      display: block;
    }
    :global(html.js) .projects :global(.sh__more) {
      display: none;
    }
    :global(html.js) .projects__grid {
      display: flex;
      align-items: stretch;
      gap: 12px;
      /* Room for the cards' shadows and the blocks over their top edge. */
      margin-block: -24px -8px;
      padding-block: 24px 8px;
    }
    :global(html.js) .projects__grid > :global(.pc) {
      flex: 0 0 min(300px, calc(100% - 58px));
    }
    :global(html.js) .carousel {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: -16px;
    }
    .carousel__key {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 2px solid var(--color-border-edge);
      background: var(--color-bg-panel);
      color: var(--color-text-hi);
      cursor: pointer;
      touch-action: manipulation;
    }
    /* At an end: dimmed and dashed (not by colour alone). */
    .carousel__key[aria-disabled='true'] {
      border-style: dashed;
      color: var(--color-text-lo);
      cursor: default;
    }
    .carousel__key:focus-visible {
      border-color: var(--color-accent-gold);
    }
    .carousel__dots {
      display: flex;
      gap: 6px;
    }
    .carousel__dots i {
      width: 10px;
      height: 10px;
      background: var(--color-border-line);
    }
    /* The card shown: a bigger square in the accent (size and colour both change). */
    .carousel__dots i[data-on] {
      width: 14px;
      height: 14px;
      margin-block: -2px;
      background: var(--color-accent-terminal-green);
    }
    .carousel__all {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin-left: auto;
      padding: 0 14px;
      border: 2px solid var(--color-accent-terminal-green);
      font: var(--type-code-label);
      letter-spacing: var(--type-code-label-tracking);
      text-transform: var(--type-label-case);
      color: var(--color-accent-terminal-green);
      text-decoration: none;
      white-space: nowrap;
      touch-action: manipulation;
    }
    .carousel__all:focus-visible {
      background: var(--color-nav-active-bg);
    }
    @media (hover: hover) {
      .carousel__all:hover {
        background: var(--color-nav-active-bg);
      }
    }
    @media (forced-colors: active) {
      .carousel__dots i[data-on] {
        background: Highlight;
      }
    }
  }
</style>
