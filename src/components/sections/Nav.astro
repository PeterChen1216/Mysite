---
/**
 * Top bar (Figma "Nav" 17:13): logo, section links, status, RESUME / SAY HI. Two keys before the
 * buttons (PLAN-EXPERIENCE §2.1, §4.1): the gear opens the settings window, ⏸ pauses every loop.
 * They need JavaScript, so they show only when it runs (html.js, set before first paint).
 */
import McButton from '../ui/McButton.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import VoxelBlock from '../ui/VoxelBlock.astro';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { copy, links } = data;
---

<header class="nav">
  <a class="nav__logo" href="#top" aria-label={copy.nav.logo_label}>
    <VoxelBlock name="terminal" size={39} shadow={false} eager />
    <span class="nav__name">{data.site.domain}</span>
    <span class="nav__cursor" data-loop="blink" aria-hidden="true"></span>
  </a>
  <nav class="nav__links" aria-label={copy.nav.sections_label}>
    <ul>
      {copy.nav.links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="nav__actions">
    <p class="nav__status">
      <span class="nav__dot" aria-hidden="true"></span>
      {copy.nav.status}
    </p>
    <div class="nav__keys">
      <button
        type="button"
        class="nav__key"
        data-prefs-open
        aria-haspopup="dialog"
        aria-controls="prefs"
        aria-label={copy.prefs.open_label}
      >
        <PixelIcon name="gear" />
      </button>
      <button
        type="button"
        class="nav__key"
        data-pause
        aria-pressed="false"
        aria-label={copy.prefs.pause_label}
      >
        <PixelIcon name="pause" class="nav__ico-pause" />
        <PixelIcon name="play" class="nav__ico-play" />
      </button>
    </div>
    <McButton href={links.resume} external>
      {copy.nav.resume}
    </McButton>
    <McButton href={links.email} kind="grass">
      {copy.nav.say_hi}
    </McButton>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    /* One row at the design's type size; with larger text (settings, text-spacing overrides) the
       groups wrap instead of running off the page. */
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--gutter);
    background: var(--color-bg-nav);
    border-bottom: 2px solid var(--color-border-line);
  }
  .nav__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-bright);
    text-decoration: none;
  }
  .nav__name {
    font: var(--type-pixel-button);
    text-shadow: 2px 2px 0 var(--color-text-shadow);
  }
  .nav__cursor {
    width: 10px;
    height: 16px;
    background: var(--color-accent-terminal-green);
  }
  .nav__links ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    display: block;
    padding: 8px 14px;
    border: 1px solid transparent;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links a:hover,
  .nav__links a:focus-visible,
  .nav__links a[aria-current='true'] {
    background: var(--color-nav-active-bg);
    border-color: var(--color-nav-active-edge);
    color: var(--color-accent-terminal-green);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
    white-space: nowrap;
  }
  .nav__keys {
    display: none;
    gap: 8px;
  }
  :global(html.js) .nav__keys {
    display: flex;
  }
  .nav__key {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 2px solid var(--color-border-edge);
    background: var(--color-bg-panel);
    color: var(--color-text-mid);
    cursor: pointer;
  }
  .nav__key:hover,
  .nav__key:focus-visible {
    border-color: var(--color-nav-active-edge);
    color: var(--color-accent-terminal-green);
  }
  /* Paused: the key shows ▶ (resume) and a gold edge — shape and colour both change. */
  .nav__key[aria-pressed='true'] {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
  }
  .nav__key :global(.nav__ico-play),
  .nav__key[aria-pressed='true'] :global(.nav__ico-pause) {
    display: none;
  }
  .nav__key[aria-pressed='true'] :global(.nav__ico-play) {
    display: block;
  }
  .nav__dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent-terminal-green);
    box-shadow: 0 0 8px 1px var(--color-glow-green);
  }
  @media (max-width: 1279px) {
    .nav {
      padding: 14px 32px;
      column-gap: 16px;
    }
    .nav__status {
      display: none;
    }
    /* Smaller keys from here down: 1024 px has to hold logo, links, keys and both buttons. */
    .nav__keys {
      gap: 4px;
      margin-inline-end: -4px;
    }
    .nav__key {
      width: 28px;
      height: 28px;
    }
  }
  @media (max-width: 1023px) {
    .nav {
      row-gap: 12px;
    }
    .nav__links {
      order: 3;
      width: 100%;
    }
    /* The links wrap rather than scroll sideways when they don't fit (narrow screens, larger
       text). */
    .nav__links ul {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 767px) {
    .nav {
      padding: 12px 16px;
    }
    /* Only SAY HI is left beside the keys; below ~385 px they wrap under the logo together. */
    .nav__actions {
      gap: 8px;
    }
    .nav__keys {
      margin-inline-end: 0;
    }
    .nav__actions :global(.mc-btn) {
      padding: 10px 12px;
    }
    .nav__actions :global(.mc-btn:first-of-type) {
      display: none;
    }
    .nav__links ul {
      justify-content: space-between;
      gap: 0;
    }
    .nav__links a {
      padding: 6px 4px;
    }
  }
</style>
