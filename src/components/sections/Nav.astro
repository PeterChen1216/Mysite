---
/** Top bar (Figma "Nav" 17:13): logo, section links, status, RESUME / SAY HI. */
import McButton from '../ui/McButton.astro';
import VoxelBlock from '../ui/VoxelBlock.astro';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { copy, links } = data;
---

<header class="nav">
  <a class="nav__logo" href="#top" aria-label={copy.nav.logo_label}>
    <VoxelBlock name="terminal" size={39} shadow={false} eager />
    <span class="nav__name">{data.site.domain}</span>
    <span class="nav__cursor" data-loop="blink" aria-hidden="true"></span>
  </a>
  <nav class="nav__links" aria-label={copy.nav.sections_label}>
    <ul>
      {copy.nav.links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="nav__actions">
    <p class="nav__status">
      <span class="nav__dot" aria-hidden="true"></span>
      {copy.nav.status}
    </p>
    <McButton href={links.resume} external>
      {copy.nav.resume}
    </McButton>
    <McButton href={links.email} kind="grass">
      {copy.nav.say_hi}
    </McButton>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--gutter);
    background: rgb(10 14 20 / 0.72);
    border-bottom: 2px solid var(--color-border-line);
  }
  .nav__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
  }
  .nav__name {
    font: var(--type-pixel-button);
    text-shadow: 2px 2px 0 #3f3f3f;
  }
  .nav__cursor {
    width: 10px;
    height: 16px;
    background: var(--color-accent-terminal-green);
  }
  .nav__links ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    display: block;
    padding: 8px 14px;
    border: 1px solid transparent;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links a:hover,
  .nav__links a:focus-visible,
  .nav__links a[aria-current='true'] {
    background: rgb(57 255 20 / 0.12);
    border-color: rgb(57 255 20 / 0.55);
    color: var(--color-accent-terminal-green);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
    white-space: nowrap;
  }
  .nav__dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent-terminal-green);
    box-shadow: 0 0 8px 1px rgb(57 255 20 / 0.8);
  }
  @media (max-width: 1279px) {
    .nav {
      padding: 14px 32px;
    }
    .nav__status {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    .nav {
      flex-wrap: wrap;
      row-gap: 12px;
    }
    .nav__links {
      order: 3;
      width: 100%;
    }
    .nav__links ul {
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
  @media (max-width: 767px) {
    .nav {
      padding: 12px 16px;
    }
    .nav__actions :global(.mc-btn) {
      padding: 10px 12px;
    }
    .nav__actions :global(.mc-btn:first-of-type) {
      display: none;
    }
    .nav__links ul {
      justify-content: space-between;
      gap: 0;
    }
    .nav__links a {
      padding: 6px 4px;
    }
  }
  @media (max-width: 369px) {
    .nav__links ul {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
</style>
