---
/**
 * Top bar (Figma "Nav" 17:13): logo, section links, status, RESUME / SAY HI. Two keys before the
 * buttons (PLAN-EXPERIENCE §2.1, §4.1): the gear opens the settings window, ⏸ pauses every loop.
 * They need JavaScript, so they show only when it runs (html.js, set before first paint).
 *
 * On phones (below 768 px; X4, Figma "Mobile/TopBar" 53:11907) it is a slim bar that stays at the
 * top: the logo — which is "back to spawn" there — the ⏸ key and RESUME. The section links and
 * the gear move to the hotbar along the foot of the screen (./Hotbar.astro); both bars slide away
 * together as the page scrolls down (src/scripts/hotbar.ts).
 */
import grass from '../../assets/voxel/blocks/grass.svg';
import Hotbar from './Hotbar.astro';
import McButton from '../ui/McButton.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import VoxelBlock from '../ui/VoxelBlock.astro';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { copy, links } = data;
// On a page of its own (a project, the directory: M3) the logo and the section links lead back to
// the home page's sections; on the home page they stay in-page anchors.
const away = data.page.kind !== 'home';
const href = (anchor: string) =>
  away && anchor.startsWith('#') ? `${data.home}${anchor}` : anchor;
---

<header class="nav">
  <a
    class="nav__logo"
    href={away ? data.home : '#top'}
    aria-label={away ? `${data.site.domain} — ${copy.windows.home_label}` : copy.nav.logo_label}
    data-spawn-block={away ? undefined : grass.src}
  >
    <VoxelBlock name="terminal" size={39} shadow={false} eager />
    <span class="nav__name">{data.site.domain}</span>
    <span class="nav__cursor" data-loop="blink" aria-hidden="true"></span>
  </a>
  <nav class="nav__links" aria-label={copy.nav.sections_label}>
    <ul>
      {copy.nav.links.map((l) => (
        <li>
          <a href={href(l.href)}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="nav__actions">
    <p class="nav__status">
      <span class="nav__dot" aria-hidden="true"></span>
      {copy.nav.status}
    </p>
    <div class="nav__keys">
      <button
        type="button"
        class="nav__key"
        data-prefs-open
        aria-haspopup="dialog"
        aria-controls="prefs"
        aria-label={copy.prefs.open_label}
      >
        <PixelIcon name="gear" />
      </button>
      <button
        type="button"
        class="nav__key"
        data-pause
        aria-pressed="false"
        aria-label={copy.prefs.pause_label}
      >
        <PixelIcon name="pause" class="nav__ico-pause" />
        <PixelIcon name="play" class="nav__ico-play" />
      </button>
    </div>
    <McButton href={links.resume} external>
      {copy.nav.resume}
    </McButton>
    <McButton href={links.email} kind="grass">
      {copy.nav.say_hi}
    </McButton>
  </div>
</header>
<Hotbar data={data} href={href} />

<style>
  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    /* One row at the design's type size; with larger text (settings, text-spacing overrides) the
       groups wrap instead of running off the page. */
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    /* Between the groups the row's free space decides (space-between); the column gap is only the
       least it may shrink to before the groups wrap. At 1280 px the row has 2 px to spare with
       the web fonts, so a 24 px minimum wrapped it whenever a fallback font was a pixel wider —
       the nav grew by a line and the page below moved 68 px when the fonts came (CLS 0.47; M5).
       16 px, as below 1280, leaves room for that and changes no pixel where the row fits. */
    gap: 24px 16px;
    padding: 16px var(--gutter);
    background: var(--color-bg-nav);
    border-bottom: 2px solid var(--color-border-line);
  }
  .nav__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-bright);
    text-decoration: none;
  }
  .nav__name {
    font: var(--type-pixel-button);
    text-shadow: 2px 2px 0 var(--color-text-shadow);
  }
  .nav__cursor {
    width: 10px;
    height: 16px;
    background: var(--color-accent-terminal-green);
  }
  .nav__links {
    position: relative;
  }
  .nav__links ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    position: relative;
    display: block;
    padding: 8px 14px;
    border: 1px solid transparent;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
    text-decoration: none;
    white-space: nowrap;
  }
  /* Hover only where there is hover (no sticky hover on touch screens; PLAN-EXPERIENCE §6). */
  @media (hover: hover) {
    .nav__links a:hover {
      background: var(--color-nav-active-bg);
      border-color: var(--color-nav-active-edge);
      color: var(--color-accent-terminal-green);
    }
  }
  .nav__links a:focus-visible,
  .nav__links a[aria-current='true'] {
    background: var(--color-nav-active-bg);
    border-color: var(--color-nav-active-edge);
    color: var(--color-accent-terminal-green);
  }
  /* Row 8 (PLAN-EXPERIENCE §6): the current section's link ends in a block cursor, in its right
     padding (where there is one: the phone layout has none). */
  @media (min-width: 768px) {
    .nav__links a[aria-current='true']::after {
      content: '';
      position: absolute;
      right: 4px;
      top: 50%;
      width: 6px;
      height: 12px;
      translate: 0 -50%;
      background: currentColor;
    }
  }
  /* … and a 2 px pixel underline slides to the link under the pointer or keyboard focus, from where
     it was (src/scripts/interact.ts places it: transform only). */
  .nav__links :global(.nav__underline) {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 2px;
    background: var(--color-accent-terminal-green);
    transform-origin: 0 0;
    opacity: 0;
    pointer-events: none;
    transition:
      translate var(--m-nav-slide),
      scale var(--m-nav-slide),
      opacity var(--m-nav-slide);
  }
  .nav__links :global(.nav__underline[data-on='true']) {
    opacity: 1;
  }
  @media (forced-colors: active) {
    .nav__links :global(.nav__underline) {
      forced-color-adjust: none;
      background: Highlight;
    }
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
    white-space: nowrap;
  }
  .nav__keys {
    display: none;
    gap: 8px;
  }
  :global(html.js) .nav__keys {
    display: flex;
  }
  .nav__key {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 2px solid var(--color-border-edge);
    background: var(--color-bg-panel);
    color: var(--color-text-mid);
    cursor: pointer;
  }
  @media (hover: hover) {
    .nav__key:hover {
      border-color: var(--color-nav-active-edge);
      color: var(--color-accent-terminal-green);
    }
  }
  .nav__key:focus-visible {
    border-color: var(--color-nav-active-edge);
    color: var(--color-accent-terminal-green);
  }
  /* Paused: the key shows ▶ (resume) and a gold edge — shape and colour both change. */
  .nav__key[aria-pressed='true'] {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
  }
  .nav__key :global(.nav__ico-play),
  .nav__key[aria-pressed='true'] :global(.nav__ico-pause) {
    display: none;
  }
  .nav__key[aria-pressed='true'] :global(.nav__ico-play) {
    display: block;
  }
  .nav__dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent-terminal-green);
    box-shadow: 0 0 8px 1px var(--color-glow-green);
  }
  @media (max-width: 1279px) {
    .nav {
      padding: 14px 32px;
      column-gap: 16px;
    }
    .nav__status {
      display: none;
    }
    /* Smaller keys from here down: 1024 px has to hold logo, links, keys and both buttons. */
    .nav__keys {
      gap: 4px;
      margin-inline-end: -4px;
    }
    .nav__key {
      width: 28px;
      height: 28px;
    }
  }
  /* 1024–1279 px: one row with 6.5 px to spare at 1024 in the web fonts; on CI's fonts a late
     font wrapped it (CLS 0.58, M5). As above 1280, the gap is only the least it may shrink to. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav {
      column-gap: 8px;
    }
  }
  @media (max-width: 1023px) {
    .nav {
      row-gap: 12px;
    }
    .nav__links {
      order: 3;
      width: 100%;
    }
    /* The links wrap rather than scroll sideways when they don't fit (narrow screens, larger
       text). */
    .nav__links ul {
      flex-wrap: wrap;
    }
  }
  /* Phones (X4, Figma "Mobile/TopBar"): 48 px, opaque, at the top of the screen as the page
     scrolls; logo, ⏸ (44 px) and RESUME (44 px). The links and the gear are in the hotbar. */
  @media (max-width: 767px) {
    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
      /* One row; with larger text the keys move under the logo rather than off the screen. */
      flex-wrap: wrap;
      gap: 0 8px;
      min-height: 48px;
      padding: max(2px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 0
        max(12px, env(safe-area-inset-left));
      background: var(--color-bg-night);
      transition: translate var(--m-bars);
    }
    :global(html[data-bars='hidden']) .nav {
      translate: 0 -100%;
    }
    :global(html:not([data-motion='full'])) .nav {
      transition: none;
    }
    .nav__logo {
      flex: none;
      gap: 8px;
      min-height: 44px;
      padding-inline: 4px;
    }
    .nav__logo :global(.voxel) {
      width: 23px;
      height: auto;
    }
    .nav__cursor {
      width: 8px;
      height: 14px;
    }
    .nav__links {
      display: none;
    }
    .nav__actions {
      gap: 8px;
      min-width: 0;
      margin-inline-start: auto;
    }
    .nav__keys {
      margin-inline-end: 0;
    }
    .nav__key {
      width: 44px;
      height: 44px;
      color: var(--color-text-hi);
    }
    .nav__key :global(.px-icon) {
      width: 18px;
      height: 18px;
    }
    .nav__key[data-prefs-open] {
      display: none;
    }
    .nav__actions :global(.mc-btn) {
      min-height: 44px;
      padding: 10px 14px;
    }
    .nav__actions :global(.mc-btn--grass) {
      display: none;
    }
  }
  /* The narrowest phones: the logo keeps its name, the bar keeps one line. */
  @media (max-width: 359px) {
    .nav__name {
      font-size: calc(10px * var(--ts));
    }
    .nav__actions :global(.mc-btn) {
      padding-inline: 10px;
    }
  }
</style>
