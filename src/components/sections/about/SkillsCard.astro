---
/**
 * Skills inventory (#skills; not in Figma — drawn in the About cards' language): one row per
 * skills.yaml group, each skill in an inventory slot, "basic" skills in dashed slots.
 * The separators are real text (visually hidden), so each <dd> reads exactly
 * "A, B, C; basic D" — for screen readers, copy/paste and the content tests (the list separator
 * is copy.yaml `labels.list_separator`).
 *
 * Hover & interaction (PLAN-EXPERIENCE §6 row 3): with JavaScript the slots are one roving-tabindex
 * list (Tab reaches it once, arrow keys move, Home / End); under the pointer, with focus, or
 * tapped, a slot's enchant glint sweeps across and its tooltip rises with the group's name, its
 * place and the count (copy.yaml about.slot_tip; src/scripts/slots.ts).
 */
import Card from '../../ui/Card.astro';
import CardTitle from '../../ui/CardTitle.astro';
import { fillTemplate } from '../../../lib/derive';
import type { PageData } from '../../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { copy, skills } = data;
const sep = copy.labels.list_separator;
/** Per group, each slot's tooltip: "Programming · 2 of 7" (its place, and how many there are). */
const tips: Record<string, string[]> = Object.fromEntries(
  skills.groups.map((g) => {
    const all = [...g.items, ...g.basic];
    return [
      g.name,
      all.map((_, i) =>
        fillTemplate(
          copy.about.slot_tip,
          { group: g.name, n: String(i + 1), count: String(all.length) },
          [],
          'copy.yaml about.slot_tip',
        ),
      ),
    ];
  }),
);
---

<Card class="about-card about-card--skills" id="skills" labelledby="about-skills">
  <div class="sk">
    <CardTitle as="h3" id="about-skills" label={copy.about.card_skills} />
    <dl class="sk__list" data-slots>
      {skills.groups.map((g) => (
        <div class="sk__row">
          <dt class="sk__name">{g.name}</dt>
          <dd class="sk__items">
            {g.items.map((item, i) => (
              <>
                {i > 0 && <span class="visually-hidden">{sep}</span>}
                <span class="sk__slot" data-tip={tips[g.name]![i]}>
                  {item}
                </span>
              </>
            ))}
            {g.basic.length > 0 && (
              <>
                <span class="visually-hidden">; </span>
                <span class="sk__basic">
                  <span class="sk__basic-label">{`${copy.about.skills_basic} `}</span>
                  {g.basic.map((item, i) => (
                    <>
                      {i > 0 && <span class="visually-hidden">{sep}</span>}
                      <span
                        class="sk__slot sk__slot--basic"
                        data-tip={tips[g.name]![g.items.length + i]}
                      >
                        {item}
                      </span>
                    </>
                  ))}
                </span>
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</Card>

<style>
  .sk {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  /* One grid for all rows (rows use display: contents), so the labels share a column. */
  .sk__list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    gap: 12px 24px;
    margin: 0;
  }
  .sk__row {
    display: contents;
  }
  .sk__name {
    font: var(--type-code-label);
    letter-spacing: var(--type-code-label-tracking);
    text-transform: var(--type-label-case);
    color: var(--color-text-mid);
  }
  .sk__name::before {
    content: '> ';
    content: '> ' / '';
    color: var(--color-accent-terminal-green);
  }
  .sk__items,
  .sk__basic {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }
  /* Inventory slot: terminal background, edge border, a pixel of inset shade. */
  .sk__slot {
    padding: 3px 8px;
    background: var(--color-bg-slot);
    border: 2px solid var(--color-border-edge);
    box-shadow: inset 2px 2px 0 var(--color-shadow-inset);
    font: var(--type-code-sm);
    color: var(--color-text-hi);
  }
  .sk__slot--basic {
    border-style: dashed;
    box-shadow: none;
    color: var(--color-text-mid);
  }
  .sk__basic-label {
    margin-left: 6px;
    font: var(--type-code-label);
    letter-spacing: var(--type-code-label-tracking);
    text-transform: var(--type-label-case);
    color: var(--color-text-mid);
  }
  @media (max-width: 767px) {
    .sk__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .sk__row + .sk__row > .sk__name {
      margin-top: 8px;
    }
  }
</style>
