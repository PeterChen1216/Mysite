---
/**
 * Hero stage (Figma "HeroStage" 17:125, 560×640): pixel globe with orbit rings, ten voxel blocks
 * that drop in, the player card (pixel portrait; hover shows the real photo — DECISIONS Q7), and
 * three tooltips whose text comes from content/ via src/lib/derive.ts. Decorative except the
 * tooltips, which repeat facts available elsewhere on the page, and the player card: it takes
 * keyboard focus so the photo can be revealed without a mouse.
 *
 * The player card (PLAN-EXPERIENCE §6 row 10): hovered, focused or tapped, the photo replaces the
 * portrait, the XP bar along its foot fills (again) to the real GPA ratio it shows at rest, and the
 * name tag offers a key that copies the GitHub handle (src/scripts/interact.ts).
 *
 * Phones (X4; §8.3, Figma "Stage · 280 px globe + 4 blocks" 56:11771): a 358 × 330 stage scaled to
 * the column (288 at 320 px, 398 at 430) — the 280 px globe and its rings, four blocks (TNT,
 * diamond, gold, grass), the name tag with its copy key showing, the player card at 92 × 115 —
 * and the three badges under it as a row to swipe (scroll-snap; the last one peeks).
 */
import { Image } from 'astro:assets';
import orbit from '../../assets/voxel/hero/orbit.png';
import orbit2 from '../../assets/voxel/hero/orbit-2.png';
import satellite from '../../assets/voxel/hero/satellite.svg';
import portrait from '../../assets/voxel/hero/portrait-pixel.svg';
import PixelGlobe from '../ui/PixelGlobe.astro';
import Tooltip from '../ui/Tooltip.astro';
import VoxelBlock, { type BlockName } from '../ui/VoxelBlock.astro';
import { fillTemplate, gpaRatio } from '../../lib/derive';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
// The XP bar shows the real GPA ratio (education.yaml `gpa`); without a GPA it stays full.
const xp = gpaRatio(data.edu.gpa) ?? 1;
const handle = data.githubHandle;

// Figma positions (px within the 560×640 stage), in the order they drop in; `phone`: the four the
// phone's 358×330 stage keeps, and where (x, y, width).
type Spot = { x: number; y: number; w: number };
const blocks: Array<{
  name: BlockName;
  x: number;
  y: number;
  w: number;
  glow?: string;
  phone?: Spot;
}> = [
  { name: 'grass', x: 352, y: 416, w: 86, phone: { x: 270, y: 250, w: 62 } },
  { name: 'grass', x: 309, y: 440, w: 86 },
  { name: 'dirt', x: 395, y: 440, w: 86 },
  { name: 'grass', x: 352, y: 464, w: 86 },
  {
    name: 'diamond',
    x: 450,
    y: 40,
    w: 69,
    glow: 'var(--color-glow-diamond)',
    phone: { x: 300, y: 0, w: 45 },
  },
  { name: 'tnt', x: 24, y: 60, w: 58, phone: { x: 8, y: 14, w: 38 } },
  { name: 'command', x: 470, y: 300, w: 67 },
  { name: 'terminal', x: 8, y: 372, w: 78 },
  { name: 'glow', x: 486, y: 200, w: 53, glow: 'var(--color-glow-gold)' },
  { name: 'gold', x: 180, y: 20, w: 47, phone: { x: 322, y: 168, w: 35 } },
];
const place = (b: (typeof blocks)[number]) =>
  [
    `--x:${b.x}px;--y:${b.y}px`,
    b.phone ? `--px:${b.phone.x}px;--py:${b.phone.y}px;--pw:${b.phone.w}px` : '',
    b.glow ? `--glow:${b.glow}` : '',
  ]
    .filter(Boolean)
    .join(';');
const badges = [
  data.hero.gpaBadge && { tone: 'gold' as const, text: data.hero.gpaBadge },
  { tone: 'white' as const, text: data.hero.avgeekBadge },
  { tone: 'cyan' as const, text: data.hero.projectBadge },
].filter((b) => !!b);
---

<div class="stage-wrap">
  <div class="stage" data-type-fixed>
    <img class="stage__orbit" src={orbit.src} width="460" height="460" alt="" data-loop="orbit" />
    <img
      class="stage__orbit2"
      src={orbit2.src}
      width="540"
      height="200"
      alt=""
      data-loop="orbit-sway"
    />
    <div class="stage__globe" data-intro="globe">
      <PixelGlobe
        size={324}
        interactive
        label={data.copy.hero.globe_label}
        valueText={data.copy.hero.globe_value}
        probe={{
          lat: data.copy.hero.globe_lat,
          lon: data.copy.hero.globe_lon,
          regions: data.copy.hero.globe_regions,
        }}
      />
    </div>
    <img
      class="stage__satellite"
      src={satellite.src}
      width="28"
      height="20"
      alt=""
      data-intro="rise"
      style="--i:0"
    />
    {blocks.map((b, i) => (
      <div
        class:list={['stage__block', { 'stage__block--phone': b.phone }]}
        data-intro="drop"
        style={`${place(b)};--i:${i}`}
      >
        <VoxelBlock name={b.name} size={b.w} shadow={false} eager />
      </div>
    ))}
    <figure
      class="stage__card"
      data-intro="rise"
      style="--i:1"
      data-particles
      data-hover-reveal
      tabindex="0"
      aria-labelledby="stage-photo-caption"
    >
      <img class="stage__portrait" src={portrait.src} width="156" height="195" alt="" />
      <Image
        class="stage__photo"
        src={data.profile.avatar}
        alt=""
        width={156}
        height={195}
        widths={[156, 312]}
        sizes="156px"
        loading="lazy"
      />
      <span class="stage__xp" aria-hidden="true" style={`--xp:${xp.toFixed(4)}`}></span>
      <figcaption id="stage-photo-caption" class="visually-hidden">
        {data.profile.avatar_alt}
      </figcaption>
    </figure>
    {handle && (
      <p class="stage__tag" data-intro="rise" style="--i:2">
        <span class="stage__tag-in">{handle}</span>
        <button
          type="button"
          class="stage__copy"
          data-copy={handle}
          data-copied={data.copy.hero.copied}
          aria-label={fillTemplate(
            data.copy.hero.copy_label,
            { handle },
            [],
            'copy.yaml hero.copy_label',
          )}
        >
          {data.copy.hero.copy_handle}
        </button>
        <span class="visually-hidden" role="status" data-copy-status></span>
      </p>
    )}
    <!-- Badges are anchored to the right edge: their text length depends on content. -->
    {data.hero.gpaBadge && (
      <div class="stage__tip stage__tip--gpa" data-intro="rise" data-particles>
        <Tooltip tone="gold" text={data.hero.gpaBadge} />
      </div>
    )}
    <div class="stage__tip" style="right:0;top:118px" data-intro="rise" data-particles>
      <Tooltip tone="white" text={data.hero.avgeekBadge} />
    </div>
    <div
      class="stage__tip stage__tip--bottom"
      style="right:0;top:596px"
      data-intro="rise"
      data-particles
    >
      <Tooltip tone="cyan" text={data.hero.projectBadge} />
    </div>
  </div>
  <!-- Phones: the badges as a row to swipe (a named region you can focus and scroll with the
       arrow keys; nothing in it is a control). -->
  <ul class="badges" role="list" tabindex="0" aria-label={data.copy.hero.badges_label}>
    {badges.map((b) => (
      <li class="badges__item">
        <Tooltip tone={b.tone} text={b.text} />
      </li>
    ))}
  </ul>
</div>

<style>
  .stage-wrap {
    container-type: inline-size;
    width: 560px;
    max-width: 100%;
    flex: none;
  }
  .stage {
    --s: 1;
    position: relative;
    width: 560px;
    height: 640px;
    transform: scale(var(--s));
    transform-origin: 0 0;
    margin-bottom: calc(640px * (var(--s) - 1));
  }
  /* --inv undoes the stage scale for the badges' text so it never drops below 8 px; below
     0.78 scale the badges and name tag are hidden (their facts are in About and Projects). */
  @container (max-width: 559px) {
    .stage {
      --s: 0.89;
      --inv: 1.124;
    }
  }
  @container (max-width: 499px) {
    .stage {
      --s: 0.78;
      --inv: 1.282;
    }
  }
  @container (max-width: 439px) {
    .stage {
      --s: 0.67;
    }
    .stage__tip,
    .stage__tag {
      display: none;
    }
  }
  @container (max-width: 379px) {
    .stage {
      --s: 0.6;
    }
  }
  @container (max-width: 339px) {
    .stage {
      --s: 0.53;
    }
  }
  .stage > * {
    position: absolute;
  }
  /* Pictures: as drawn in the colour themes, greyscale in Mono (--art-filter, §3.4). */
  .stage__orbit,
  .stage__orbit2,
  .stage__satellite,
  .stage__portrait,
  .stage__photo {
    filter: var(--art-filter);
  }
  .stage__orbit {
    left: 60px;
    top: 70px;
    width: 460px;
    height: 460px;
    max-width: none;
  }
  /* Figma: a 540×200 ring centred in a 575×357 box at (−41.8, 200), tilted +18° (17:127). */
  .stage__orbit2 {
    left: -24.1px;
    top: 278.5px;
    width: 540px;
    height: 200px;
    max-width: none;
    transform: rotate(18deg);
  }
  .stage__globe {
    left: 128px;
    top: 138px;
  }
  .stage__satellite {
    left: 74px;
    top: 128px;
  }
  .stage__block {
    left: var(--x);
    top: var(--y);
    filter: drop-shadow(8px 8px 0 var(--color-shadow-block))
      drop-shadow(0 0 14px var(--glow, transparent));
  }
  .stage__card {
    left: 8px;
    top: 440px;
    width: 156px;
    height: 195px;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-panel);
    border: 3px solid var(--color-ink);
    box-shadow: 8px 8px 0 0 var(--color-shadow-term);
    box-sizing: content-box;
  }
  .stage__portrait,
  .stage__photo {
    position: absolute;
    inset: 0;
    width: 156px;
    height: 195px;
    max-width: none;
    object-fit: cover;
  }
  .stage__photo {
    opacity: 0;
    /* src/motion/params.ts UI.photoSwap */
    transition: opacity var(--m-photo-swap);
  }
  @media (hover: hover) {
    .stage__card:hover .stage__photo {
      opacity: 1;
    }
  }
  .stage__card:focus-visible .stage__photo,
  .stage__card[data-active] .stage__photo {
    opacity: 1;
  }
  /* Escape hides the photo again until the pointer leaves or focus moves (WCAG 1.4.13). */
  .stage__card[data-dismissed] .stage__photo {
    opacity: 0;
  }
  /* The XP bar: filled to the GPA ratio (--xp), the rest an empty track. Hovered, focused or
     tapped (motion full) it fills again from empty: a track-coloured cover over the bar shrinks
     back to the ratio (transform only). */
  .stage__xp {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: linear-gradient(
      90deg,
      var(--color-accent-terminal-green) calc(var(--xp, 1) * 100%),
      var(--color-bg-slot) 0
    );
  }
  .stage__xp::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg-slot);
    transform-origin: 100% 0;
    scale: 0 1;
  }
  @media (hover: hover) {
    :global(html.motion[data-motion='full']) .stage__card:hover .stage__xp::before {
      animation: xp-fill var(--m-enter) steps(12);
    }
  }
  :global(html.motion[data-motion='full']) .stage__card:focus-visible .stage__xp::before,
  :global(html.motion[data-motion='full']) .stage__card[data-active] .stage__xp::before {
    animation: xp-fill var(--m-enter) steps(12);
  }
  @keyframes xp-fill {
    from {
      scale: 1 1;
    }
    to {
      scale: calc(1 - var(--xp, 1)) 1;
    }
  }
  .stage__tag {
    left: 18px;
    top: 408px;
    margin: 0;
  }
  /* The copy key sits beside the tag (absolute: nothing moves), shown with the card's hover,
     focus or tap, or its own focus; it needs JavaScript. */
  .stage__copy {
    position: absolute;
    left: calc(100% + 4px);
    top: 0;
    display: none;
    height: 100%;
    padding: 0 8px;
    border: 0;
    background: var(--color-tag-bg);
    font: var(--type-pixel-tiny);
    letter-spacing: var(--type-pixel-tiny-tracking);
    color: var(--color-accent-terminal-green);
    white-space: nowrap;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    zoom: var(--inv, 1);
  }
  :global(html.js) .stage__copy {
    display: block;
  }
  @media (hover: hover) {
    .stage__card:hover ~ .stage__tag .stage__copy,
    .stage__tag:hover .stage__copy {
      opacity: 1;
      pointer-events: auto;
    }
  }
  .stage__card:focus-visible ~ .stage__tag .stage__copy,
  .stage__card[data-active] ~ .stage__tag .stage__copy,
  .stage__copy:focus-visible,
  .stage__copy[data-done] {
    opacity: 1;
    pointer-events: auto;
  }
  @media (forced-colors: active) {
    .stage__copy {
      border: 1px solid ButtonText;
    }
  }
  .stage__tag-in {
    display: block;
    padding: 6px 8px;
    background: var(--color-tag-bg);
    font: var(--type-pixel-tiny);
    letter-spacing: var(--type-pixel-tiny-tracking);
    color: var(--color-paper);
    zoom: var(--inv, 1);
  }
  /* GPA badge: right-anchored so a long honor name can't run off the page. It is longer than
     Figma's (the honor's full name comes from content), so where there is room beside the
     unscaled stage — side by side from 1280 px, centred and stacked at 672–1023 px — it
     overhangs the stage by 40 px (Figma: 24 px) to stay clear of the gold block. Elsewhere it
     covers part of the gold block: its top half where the stage is scaled down and the badge
     keeps its full text size, a 13×14 px corner at 592–671 px (docs/STATUS.md D). */
  .stage__tip--gpa {
    right: 0;
    top: 8px;
  }
  @media (min-width: 1280px), (min-width: 672px) and (max-width: 1023px) {
    .stage__tip--gpa {
      right: -40px;
    }
  }
  /* Zoom the badge itself (not its positioned wrapper, whose offsets must not scale). */
  .stage__tip > :global(.tooltip) {
    zoom: var(--inv, 1);
  }
  .badges {
    display: none;
  }
  /* Phones (X4): the 358 × 330 stage of the frame, scaled to the column (100cqw / 358 px; where
     the browser cannot divide lengths, in steps). Only its four blocks; the badges move out. */
  @media (max-width: 767px) {
    /* A column: the scaled stage's margin and the badges' never collapse into one. */
    .stage-wrap {
      display: flex;
      flex-direction: column;
      width: 100%;
    }
    /* Never more than 1.2× (430 px of stage) on the widest phone-layout screens (to 767 px),
       centred in the column. */
    .stage-wrap .stage {
      --s: min(tan(atan2(100cqw, 358px)), 1.2);
      width: 358px;
      height: 330px;
      margin-inline: auto;
      margin-bottom: calc(330px * (var(--s) - 1));
      transform-origin: 50% 0;
    }
    .stage-wrap .stage__orbit {
      left: 20px;
      top: 6px;
      width: 318px;
      height: 318px;
      opacity: 0.45;
    }
    /* The frame's 358 × 118 box (centred at y 171) squashes the 540 × 200 ring: it keeps its own
       proportions here, centred on the same line (an image is never shown distorted). */
    .stage-wrap .stage__orbit2 {
      left: 0;
      top: calc(171px - 358px * 100 / 540);
      width: 358px;
      height: calc(358px * 200 / 540);
      transform: none;
      opacity: 0.6;
    }
    /* The 324 px globe shown at 280 (Figma): scaled about its centre, which the intro scales too. */
    .stage-wrap .stage__globe {
      left: 17px;
      top: 3px;
      scale: calc(280 / 324);
    }
    .stage-wrap .stage__satellite,
    .stage-wrap .stage__block:not(.stage__block--phone),
    .stage-wrap .stage__tip {
      display: none;
    }
    .stage-wrap .stage__block {
      left: var(--px);
      top: var(--py);
      filter: drop-shadow(5px 5px 0 var(--color-shadow-block))
        drop-shadow(0 0 8px var(--glow, transparent));
    }
    .stage__block :global(.voxel) {
      width: var(--pw);
      height: auto;
    }
    .stage-wrap .stage__card {
      left: 10px;
      top: 206px;
      width: 92px;
      height: 115px;
      box-shadow: 6px 6px 0 0 var(--color-shadow-term);
    }
    .stage-wrap .stage__portrait,
    .stage-wrap .stage__photo {
      width: 92px;
      height: 115px;
    }
    .stage-wrap .stage__xp {
      height: 4px;
    }
    /* The name tag, its copy key showing (tap = copy the handle); 44 px tall to the touch. */
    /* 8 px above the card (Figma 2): two targets, kept apart (§8.4). */
    .stage-wrap .stage__tag {
      left: 6px;
      top: 172px;
      display: flex;
      align-items: center;
      background: var(--color-tag-bg);
      --inv: 1;
    }
    .stage-wrap .stage__copy {
      position: relative;
      left: auto;
      height: auto;
      align-self: stretch;
      /* At least 24 px on screen at any scale of the stage (WCAG 2.5.8, with a mouse too): 25,
         so that scaling back down never rounds it to 23.99. */
      min-height: calc(25px / var(--s));
      /* 44 px wide on screen, so that its hit area (below) needs no room at the sides. */
      min-width: calc(44px / var(--s));
      background: none;
      opacity: 1;
      pointer-events: auto;
      padding: 0 8px 0 0;
    }
    /* Its hit area: 44 px tall, rising over the globe (never down onto the card under it). */
    .stage-wrap .stage__copy::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      /* 44 px on screen, whatever the stage's scale. */
      height: calc(44px / var(--s));
    }
    .badges {
      display: flex;
      gap: 8px;
      margin: 14px 0 0;
      padding: 0 0 10px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      list-style: none;
      overscroll-behavior-x: contain;
    }
    .badges::-webkit-scrollbar {
      display: none;
    }
    .badges__item {
      flex: none;
      scroll-snap-align: start;
    }
    .badges :global(.tooltip) {
      padding: 10px 12px;
      white-space: nowrap;
    }
  }
  /* Browsers that cannot divide lengths (tan(atan2())): the stage in steps. */
  @supports not (scale: tan(atan2(1px, 1px))) {
    @media (max-width: 767px) {
      .stage-wrap .stage {
        --s: 1;
      }
      @container (max-width: 357px) {
        .stage-wrap .stage {
          --s: 0.9;
        }
      }
      @container (max-width: 321px) {
        .stage-wrap .stage {
          --s: 0.8;
        }
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage__photo {
      transition: none;
    }
  }
  /* Graphics tier 3 (src/scene/): once the intro has played, the WebGL world draws the globe,
     rings, satellite and blocks behind the page, where these stood. The globe's slider stays
     (invisible) over the WebGL Earth and turns it; the player card and the badges stay. */
  :global(html[data-scene='live']) .stage__orbit,
  :global(html[data-scene='live']) .stage__orbit2,
  :global(html[data-scene='live']) .stage__satellite,
  :global(html[data-scene='live']) .stage__block,
  :global(html[data-scene='live']) .stage__globe :global(.globe__inner) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--m-scene-fade),
      visibility 0s linear var(--m-scene-fade);
  }
  :global(html[data-scene='live']) .stage__orbit,
  :global(html[data-scene='live']) .stage__orbit2 {
    animation-play-state: paused !important;
  }
</style>
