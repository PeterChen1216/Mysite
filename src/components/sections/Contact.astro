---
/**
 * Contact (Figma "Contact" 22:1612): `$ ping` eyebrow, the big pixel heading, the ping terminal
 * (copy.yaml contact.ping + `open mailto:` with a blinking cursor), the MC buttons and every public
 * email address as a mailto link. The floating blocks are decorative (aria-hidden).
 *
 * Phones (X4; §8.3, Figma "Contact" 69:15372): the big heading, one primary button (SAY HI ·
 * EMAIL), the others as a row of 56 px stone keys with their names under them, and each email
 * address on a row of its own — a mailto link (selectable text) with a 44 px copy key: a copy says
 * `[OK] copied <address>` in a toast above the hotbar (role="status"; src/scripts/mobile.ts) and on
 * the key. Without the Clipboard API the address is selected instead. No ping terminal there.
 */
import PixelIcon from '../ui/PixelIcon.astro';
import { fillTemplate } from '../../lib/derive';
import McButton from '../ui/McButton.astro';
import TerminalWindow from '../ui/TerminalWindow.astro';
import VoxelBlock from '../ui/VoxelBlock.astro';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { copy, links } = data;
const { ping } = copy.contact;
// The phone's row of keys (X4): GitHub, LinkedIn, the résumé — each a 56 px stone key and its name.
const keys = [
  links.github && {
    href: links.github,
    icon: 'code' as const,
    label: copy.contact.github,
    external: true,
  },
  links.linkedin && {
    href: links.linkedin,
    icon: 'linkedin' as const,
    label: copy.contact.linkedin,
    external: true,
  },
  { href: links.resume, icon: 'doc' as const, label: copy.contact.resume, external: false },
].filter((k) => !!k);
const copyName = (address: string) =>
  fillTemplate(copy.hero.copy_label, { handle: address }, [], 'copy.yaml hero.copy_label');
const newTab = copy.labels.new_tab;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__deco" aria-hidden="true">
    <!-- Figma: grass 120/80, grass 72/108, dirt 168/108 (back to front). -->
    <div class="contact__cluster">
      <VoxelBlock name="grass" size={97} style="left:48px;top:0" />
      <VoxelBlock name="grass" size={97} style="left:0;top:28px" />
      <VoxelBlock name="dirt" size={97} style="left:96px;top:28px" />
    </div>
    <span class="contact__block contact__block--glow">
      <VoxelBlock name="glow" size={62} />
    </span>
    <span class="contact__block contact__block--diamond">
      <VoxelBlock name="diamond" size={55} />
    </span>
    <span class="contact__block contact__block--tnt">
      <VoxelBlock name="tnt" size={50} />
    </span>
  </div>

  <div class="contact__head">
    <p class="contact__cmd" aria-hidden="true">
      <span class="g">$</span> {copy.contact.cmd}
    </p>
    <h2 id="contact-title" class="contact__title">
      {copy.contact.title.map((line, i) => (
        <>
          {line}
          {i < copy.contact.title.length - 1 && <br />}
        </>
      ))}
    </h2>
  </div>

  <TerminalWindow title={copy.contact.terminal_title} font="code" class="contact__term">
    <p class="ping">{ping.request}</p>
    <p class="ping ping--ok">{ping.reply}</p>
    <p class="ping">{ping.summary}</p>
    <p class="ping ping--cmd">
      <span class="g">$ </span>
      {copy.contact.open_cmd}
      <span class="cursor" data-loop="blink" aria-hidden="true"></span>
    </p>
  </TerminalWindow>

  <div class="contact__actions">
    <div class="contact__btns">
      <McButton href={links.email} kind="grass">
        {copy.contact.say_hi}
      </McButton>
      {links.github && (
        <McButton href={links.github} external>
          {copy.contact.github}
          <svg class="ext" viewBox="0 0 5 5" width="10" height="10" aria-hidden="true">
            <path d="M2 0h3v1H2zM3 1h2v1H3zM2 2h1v1H2zM4 2h1v1H4zM1 3h1v1H1zM0 4h1v1H0z" />
          </svg>
        </McButton>
      )}
      {links.linkedin && (
        <McButton href={links.linkedin} external>
          {copy.contact.linkedin}
          <svg class="ext" viewBox="0 0 5 5" width="10" height="10" aria-hidden="true">
            <path d="M2 0h3v1H2zM3 1h2v1H3zM2 2h1v1H2zM4 2h1v1H4zM1 3h1v1H1zM0 4h1v1H0z" />
          </svg>
        </McButton>
      )}
      <McButton href={links.resume} download={links.resumeFile}>
        {copy.contact.resume}
      </McButton>
    </div>
    <ul class="contact__keys">
      {keys.map((k) => (
        <li>
          <a
            class="contact__key"
            href={k.href}
            {...(k.external
              ? { target: '_blank', rel: 'noopener' }
              : { download: links.resumeFile })}
          >
            <span class="contact__stone" aria-hidden="true">
              <PixelIcon name={k.icon} scale={3} />
            </span>
            <span class="contact__key-name">
              {k.label}
              {k.external && (
                <>
                  <span class="contact__key-ext" aria-hidden="true">
                    {' ↗'}
                  </span>
                  <span class="visually-hidden"> {newTab}</span>
                </>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="contact__mail">
      <span class="contact__mail-label">{copy.contact.emails_label}</span>
      <ul class="contact__mail-list">
        {data.publicEmails.map((address) => (
          <li>
            <span class="contact__dollar" aria-hidden="true">
              ${' '}
            </span>
            <a class="hit-44" href={`mailto:${address}`}>
              {address}
            </a>
            <button
              type="button"
              class="contact__copy"
              data-copy-email={address}
              aria-label={copyName(address)}
            >
              <PixelIcon name="copy" scale={2} class="contact__copy-icon" />
              <PixelIcon name="check" scale={2} class="contact__copied-icon" />
              <span class="contact__copy-word">{copy.hero.copy_handle}</span>
              <span class="contact__copied-word">{copy.hero.copied}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 140px var(--gutter) 100px;
    overflow-x: clip;
  }

  /* ---------- decorative blocks (Figma positions in the 1440 frame) ---------- */
  .contact__deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .contact__deco :global(.voxel) {
    pointer-events: auto;
  }
  .contact__cluster {
    position: absolute;
    left: 72px;
    top: 80px;
    width: 193px;
    height: 140px;
    transform-origin: 0 0;
  }
  .contact__cluster :global(.voxel) {
    position: absolute;
  }
  .contact__block {
    position: absolute;
    display: block;
  }
  /* Glowstone: Figma left 1180 → anchored to the right edge so it stays clear of the heading. */
  .contact__block--glow {
    right: 198px;
    top: 120px;
    filter: drop-shadow(0 0 18px var(--color-glow-gold));
  }
  /* Diamond: 40 px right of the 680 px terminal (Figma left 1100 = centre + 380). */
  .contact__block--diamond {
    left: calc(50% + 380px);
    top: 360px;
    filter: drop-shadow(0 0 11px var(--color-glow-diamond));
  }
  .contact__block--tnt {
    left: 40px;
    top: 400px;
  }

  /* ---------- heading ---------- */
  .contact__head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 800px;
    text-align: center;
  }
  .contact__cmd {
    margin: 0;
    font: var(--type-code-label);
    letter-spacing: var(--type-code-label-tracking);
    text-transform: var(--type-label-case);
    color: var(--color-accent-diamond);
  }
  .g {
    color: var(--color-accent-terminal-green);
  }
  .contact__title {
    margin: 0;
    font: var(--type-pixel-display);
    letter-spacing: var(--type-pixel-display-tracking);
    color: var(--color-text-hi);
    text-shadow: 4px 4px 0 var(--color-heading-shadow);
  }

  /* ---------- ping terminal ---------- */
  .contact :global(.contact__term) {
    position: relative;
    width: 680px;
    box-shadow: 6px 6px 0 0 var(--color-shadow);
  }
  .ping {
    margin: 0;
    color: var(--color-text-mid);
    overflow-wrap: anywhere;
  }
  .ping--ok {
    color: var(--color-accent-terminal-green);
  }
  .ping--cmd {
    color: var(--color-text-hi);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--color-accent-terminal-green);
  }

  /* ---------- buttons + emails ---------- */
  .contact__actions {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 100%;
  }
  .contact__btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .ext {
    display: inline-block;
    margin-left: 10px;
    vertical-align: 0;
    fill: currentColor;
    shape-rendering: crispEdges;
    filter: drop-shadow(2px 2px 0 var(--color-text-shadow));
  }
  /* Row 13: the pixel ↗ of an external button hops a pixel up-right. */
  @media (hover: hover) {
    .contact__btns :global(.mc-btn:hover) .ext {
      translate: var(--m-hop) calc(-1 * var(--m-hop));
    }
  }
  .contact__btns :global(.mc-btn:focus-visible) .ext {
    translate: var(--m-hop) calc(-1 * var(--m-hop));
  }
  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    font: var(--type-code-sm);
    color: var(--color-text-mid);
  }
  .contact__mail-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact__mail-list li + li::before {
    content: '·';
    content: '·' / '';
    margin-right: 12px;
    color: var(--color-text-mid);
  }
  .contact__mail-list a {
    color: var(--color-accent-diamond);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .contact__mail-list a:hover,
  .contact__mail-list a:focus-visible {
    color: var(--color-accent-gold);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1279px) {
    .contact {
      padding: 120px 32px 88px;
    }
    /* Keep the blocks clear of the 84 px heading on small laptops. */
    .contact__cluster {
      left: 32px;
      top: 48px;
      transform: scale(0.75);
    }
    .contact__block--glow {
      right: 64px;
    }
  }
  @media (max-width: 1023px) {
    .contact__title {
      font-size: calc(64px * var(--ts));
    }
    /* Chinese: 12 px multiples for the pixel CJK face (PLAN-EXPERIENCE §5.5). */
    :global(:root:lang(zh)) .contact__title {
      font-size: calc(60px * var(--ts));
    }
    .contact__btns :global(.mc-btn) {
      padding-inline: 18px;
    }
    .contact__cluster {
      left: 24px;
      top: 24px;
      transform: scale(0.6);
    }
    .contact__block--glow {
      right: 24px;
      top: 32px;
    }
    .contact__block--diamond,
    .contact__block--tnt {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .contact {
      gap: 32px;
      padding: 104px 16px 64px;
    }
    .contact__title {
      font-size: calc(44px * var(--ts));
    }
    :global(:root:lang(zh)) .contact__title {
      font-size: calc(36px * var(--ts));
    }
    .contact__cluster {
      left: 16px;
      top: 16px;
      transform: scale(0.45);
    }
    .contact__block--glow {
      right: 16px;
      top: 20px;
    }
    .contact__block--glow :global(.voxel) {
      width: 40px;
      height: auto;
    }
    .contact :global(.contact__term .term__body) {
      padding: 14px;
      font-size: calc(13px * var(--ts));
    }
    .contact__btns :global(.mc-btn) {
      padding: 12px 16px;
    }
  }

  /* ---------- phones (X4): one primary button, a row of keys, the addresses as rows ---------- */
  .contact__keys,
  .contact__dollar,
  .contact__copy {
    display: none;
  }
  @media (max-width: 767px) {
    .contact {
      align-items: stretch;
    }
    .contact :global(.contact__term) {
      display: none;
    }
    .contact__actions {
      align-items: stretch;
      width: 100%;
    }
    .contact__btns :global(.mc-btn:not(.mc-btn--grass)) {
      display: none;
    }
    .contact__btns :global(.mc-btn--grass) {
      flex: 1;
      justify-content: center;
      min-height: 52px;
    }
    .contact__keys {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .contact__key {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
      color: var(--color-text-mid);
      text-decoration: none;
      touch-action: manipulation;
    }
    /* A stone key, as the MC buttons: bevels, a hard edge, pressed down 2 px. */
    .contact__stone {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border: 2px solid var(--mc-border);
      background: var(--mc-stone-bg);
      box-shadow:
        inset 0 3px 0 0 var(--mc-stone-hi),
        inset 0 -4px 0 0 var(--mc-stone-lo);
      color: var(--mc-stone-fg);
    }
    .contact__stone :global(.px-icon) {
      filter: drop-shadow(2px 2px 0 var(--mc-text-shadow));
    }
    .contact__key:active .contact__stone {
      translate: 0 2px;
    }
    .contact__key:focus-visible {
      outline-offset: 4px;
    }
    .contact__key:focus-visible .contact__stone {
      background: var(--mc-hover-bg);
      color: var(--mc-hover-fg);
    }
    /* Row 13: the ↗ hops a pixel up-right with focus (and under a mouse). */
    .contact__key-ext {
      position: relative;
    }
    .contact__key:focus-visible .contact__key-ext {
      left: var(--m-hop);
      top: calc(-1 * var(--m-hop));
    }
    @media (hover: hover) {
      .contact__key:hover .contact__key-ext {
        left: var(--m-hop);
        top: calc(-1 * var(--m-hop));
      }
    }
    .contact__key-name {
      font: var(--type-code-label);
      letter-spacing: var(--type-code-label-tracking);
      text-transform: var(--type-label-case);
      text-align: center;
    }
    .contact__mail {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .contact__mail-list {
      flex-direction: column;
      gap: 0;
      background: var(--color-bg-slot);
      border: 2px solid var(--color-border-edge);
      box-shadow: 6px 6px 0 0 var(--color-shadow);
    }
    .contact__mail-list li {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 52px;
      padding: 4px 6px 4px 16px;
    }
    .contact__mail-list li + li {
      border-top: 2px solid var(--color-border-edge);
    }
    .contact__mail-list li + li::before {
      display: none;
    }
    .contact__dollar {
      display: inline;
      font: var(--type-code-bold);
      color: var(--color-accent-terminal-green);
    }
    .contact__mail-list a {
      flex: 1;
      min-width: 0;
      color: var(--color-text-hi);
      text-decoration: none;
      user-select: text;
    }
    :global(html.js) .contact__copy {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 8px;
      min-width: 44px;
      min-height: 44px;
      padding: 0 12px;
      border: 2px solid var(--color-border-edge);
      background: none;
      font: var(--type-code-label);
      letter-spacing: var(--type-code-label-tracking);
      text-transform: var(--type-label-case);
      color: var(--color-accent-terminal-green);
      cursor: pointer;
      touch-action: manipulation;
    }
    .contact__copy :global(.contact__copied-icon),
    .contact__copied-word,
    .contact__copy[data-done] :global(.contact__copy-icon),
    .contact__copy[data-done] .contact__copy-word {
      display: none;
    }
    .contact__copy[data-done] :global(.contact__copied-icon),
    .contact__copy[data-done] .contact__copied-word {
      display: inline;
    }
    /* Copied: a green edge and the row lit — and the key says so in words and a tick. */
    .contact__copy[data-done] {
      border-color: var(--color-accent-terminal-green);
    }
    .contact__mail-list li:has(.contact__copy[data-done]) {
      background: var(--color-nav-active-bg);
    }
    .contact__copy:focus-visible {
      border-color: var(--color-accent-gold);
    }
  }
</style>
