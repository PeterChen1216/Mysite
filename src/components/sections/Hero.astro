---
/** Hero (Figma "Hero" 17:94): eyebrow, headline, typed terminal, CTAs, links + the stage. */
import McButton from '../ui/McButton.astro';
import NewTab from '../ui/NewTab.astro';
import TerminalWindow from '../ui/TerminalWindow.astro';
import HeroStage from './HeroStage.astro';
import { headlineWords } from '../../lib/derive';
import { INTRO, typingMs } from '../../motion/params';
import type { PageData } from '../../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const { copy, hero, links, profile } = data;

// Headline words, each animated in turn (Figma: word-by-word rise); a highlighted part made of
// symbols only (the `[_]` cursor) is hidden from screen readers (derive.headlineWords).
const headline = headlineWords(copy.hero.headline);

// Terminal lines type one after another; pace from src/motion/params.ts.
const lines = [
  { kind: 'cmd', text: copy.hero.cmd_whoami },
  { kind: 'out', text: hero.whoami },
  { kind: 'cmd', text: copy.hero.cmd_interests },
  { kind: 'tags', text: hero.tags.map((t) => `${t}/`).join('   ') },
  { kind: 'cmd', text: copy.hero.summon },
  { kind: 'ok', text: hero.summonOk },
] as const;
let at = INTRO.typing.startMs;
const typed = lines.map((l) => {
  const chars =
    l.text.length + (l.kind === 'cmd' ? 2 : l.kind === 'ok' ? copy.hero.ok.length + 1 : 0);
  const out = { ...l, steps: chars, dur: typingMs(chars), delay: at };
  at += out.dur;
  return out;
});
// The last line, `$ █`, types like the others before the cursor starts blinking.
const cursor = { steps: 3, dur: typingMs(3), delay: at };
// With JavaScript that line is a key that opens a real prompt (PLAN-EXPERIENCE §6 row 12,
// src/scripts/prompt.ts). It can only say what the page says: these words and facts.
const themeNames = Object.fromEntries(
  Object.entries(copy.prefs.theme.options).map(([k, o]) => [k, o.name]),
);
const prompt = JSON.stringify({
  ...copy.hero.prompt,
  whoami: hero.whoami,
  interests: hero.tags.map((t) => `${t}/`).join('   '),
  sections: copy.nav.links.map((l) => l.label),
  resume: { href: links.resume, name: links.resume.split('/').pop() },
  themes: themeNames,
});
---

<section class="hero" aria-labelledby="hero-title" id="top">
  <div class="hero__copy">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title" class="hero__h1">
      <span class="visually-hidden">{profile.name.display} — </span>
      {headline.map((line) => (
        <span class="hero__line">
          {line.map((t) =>
            'space' in t ? (
              ' '
            ) : (
              <span
                data-intro="word"
                class:list={{ hi: t.hi }}
                style={`--i:${t.i}`}
                aria-hidden={t.deco ? 'true' : undefined}
              >
                {t.text}
              </span>
            ),
          )}
        </span>
      ))}
    </h1>
    <TerminalWindow title={copy.hero.terminal_title} class="hero__term">
      {typed.map((l) => (
        <p
          class:list={['hero__ln', `hero__ln--${l.kind}`]}
          data-intro="type"
          style={`--steps:${l.steps};--dur:${l.dur}ms;--d:${l.delay}ms`}
        >
          {l.kind === 'cmd' && <span class="g">$ </span>}
          {l.kind === 'ok' && <span class="g">{copy.hero.ok} </span>}
          {l.text}
        </p>
      ))}
      <p
        class="hero__ln"
        aria-hidden="true"
        data-intro="type"
        data-prompt={prompt}
        style={`--steps:${cursor.steps};--dur:${cursor.dur}ms;--d:${cursor.delay}ms`}
      >
        <span class="g">$ </span>
        <span class="hero__cursor" data-loop="blink">
          █
        </span>
      </p>
    </TerminalWindow>
    <div class="hero__ctas">
      <McButton href="#projects" kind="grass">
        {copy.hero.cta_projects}
      </McButton>
      <McButton href={links.resume} download={links.resumeFile}>
        {copy.hero.cta_resume}
      </McButton>
    </div>
    <ul class="hero__links">
      {data.socials.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target="_blank">
            {s.display}{' '}
            <span class="ext-arrow" aria-hidden="true">
              ↗
            </span>
            <NewTab />
          </a>
        </li>
      ))}
      <li>
        <a href={links.email}>{data.primaryEmail}</a>
      </li>
    </ul>
  </div>
  <HeroStage data={data} />
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 56px var(--gutter) 72px;
  }
  .hero__copy {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero__eyebrow {
    margin: 0;
    font: var(--type-pixel-label);
    letter-spacing: var(--type-pixel-label-tracking);
    text-transform: var(--type-label-case);
    color: var(--color-accent-diamond);
    white-space: pre-wrap;
  }
  .hero__h1 {
    margin: 0;
    max-width: 720px;
    font: var(--type-pixel-display);
    letter-spacing: var(--type-pixel-display-tracking);
    color: var(--color-text-hi);
    text-shadow: 4px 4px 0 var(--color-heading-shadow-lo);
  }
  .hero__line {
    display: block;
  }
  .hero__h1 .hi {
    color: var(--color-accent-terminal-green);
  }
  /* TerminalWindow is a child component: scoped styles need :global() to reach its root. */
  .hero__copy :global(.hero__term) {
    width: 640px;
    max-width: 100%;
  }
  .hero__ln {
    margin: 0;
    color: var(--color-text-mid);
  }
  .hero__ln--cmd {
    color: var(--color-text-hi);
  }
  .hero__ln--tags {
    color: var(--color-accent-diamond);
    white-space: pre-wrap;
  }
  /* Chinese (larger terminal type, so the tags wrap elsewhere): the spaces between tags may
     wrap too instead of hanging past the edge, as WebKit draws them with a text-spacing
     override. */
  :global(:root:lang(zh)) .hero__ln--tags {
    white-space: break-spaces;
  }
  .g {
    color: var(--color-accent-terminal-green);
  }
  .hero__cursor {
    color: var(--color-accent-terminal-green);
  }
  /* Row 12: the `$ █` line as a key (made by src/scripts/interact.ts) looks as it did. */
  .hero__copy :global(.hero__prompt) {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    color: inherit;
    text-align: inherit;
    cursor: text;
  }
  @media (forced-colors: active) {
    .hero__copy :global(.hero__prompt),
    .hero__copy :global(.prompt__input) {
      border: 1px solid ButtonText;
    }
  }
  /* The open prompt: the terminal keeps its height and scrolls (nothing on the page moves). */
  .hero__copy :global(.term__body--prompt) {
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-edge) transparent;
  }
  .hero__copy :global(.prompt__log) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hero__copy :global(.prompt__log > p),
  .hero__copy :global(.prompt__hint) {
    margin: 0;
    color: var(--color-text-mid);
    overflow-wrap: anywhere;
  }
  .hero__copy :global(.prompt__log > .prompt__echo) {
    color: var(--color-text-hi);
  }
  .hero__copy :global(.prompt) {
    margin: 0;
  }
  .hero__copy :global(.prompt__dollar) {
    color: var(--color-accent-terminal-green);
    white-space: pre;
  }
  .hero__copy :global(.prompt) {
    display: flex;
    align-items: baseline;
    color: var(--color-text-hi);
  }
  .hero__copy :global(.prompt__input) {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-text-hi);
    caret-color: var(--color-accent-terminal-green);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: var(--type-code-sm);
  }
  .hero__links a {
    color: var(--color-text-mid);
    text-decoration: none;
  }
  @media (hover: hover) {
    .hero__links a:hover {
      color: var(--color-accent-diamond);
      text-decoration: underline;
    }
  }
  .hero__links a:focus-visible {
    color: var(--color-accent-diamond);
    text-decoration: underline;
  }
  /* Where the column is just too narrow for the longest headline line ("Crafting data") at the
     design size, a slightly smaller size keeps it on one line. Otherwise it would wrap only once
     the pixel font arrives (its stand-in is narrower), and the hero would jump (CLS ≈ 0.18). */
  @media (min-width: 1280px) and (max-width: 1319px) {
    .hero__h1 {
      font-size: calc(78px * var(--ts));
    }
  }
  @media (max-width: 1279px) {
    /* Stay side by side down to 1024: the stage scales via its container queries. */
    .hero {
      padding: 48px 32px 56px;
      gap: 32px;
    }
    .hero__h1 {
      font-size: calc(64px * var(--ts));
    }
    .hero :global(.stage-wrap) {
      width: clamp(380px, 40vw, 560px);
    }
  }
  @media (max-width: 1023px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__h1 {
      font-size: calc(56px * var(--ts));
    }
    .hero__copy :global(.hero__term) {
      width: 100%;
    }
    .hero :global(.stage-wrap) {
      width: 560px;
      align-self: center;
    }
  }
  @media (max-width: 767px) {
    .hero {
      padding: 32px 16px 40px;
      gap: 32px;
    }
    .hero__h1 {
      font-size: calc(44px * var(--ts));
    }
    .hero__copy :global(.hero__term .term__body) {
      font-size: calc(20px * var(--ts));
      padding: 14px;
    }
  }
  /* The same for the narrowest phones (see the 1280–1319 rule above). */
  @media (max-width: 341px) {
    .hero__h1 {
      font-size: calc(40px * var(--ts));
    }
  }
  /* Chinese (PLAN-EXPERIENCE §5.5): the pixel CJK face is drawn on a 12 px grid, so the headline
     steps through 12 px multiples, each sized so the longest line (seven characters and the
     cursor) stays on one line in its column. */
  @media (min-width: 1280px) and (max-width: 1359px) {
    :global(:root:lang(zh)) .hero__h1 {
      font-size: calc(72px * var(--ts));
    }
  }
  @media (max-width: 1279px) {
    :global(:root:lang(zh)) .hero__h1 {
      font-size: calc(60px * var(--ts));
    }
  }
  @media (max-width: 1023px) {
    :global(:root:lang(zh)) .hero__h1 {
      font-size: calc(48px * var(--ts));
    }
  }
  @media (max-width: 767px) {
    :global(:root:lang(zh)) .hero__h1 {
      font-size: calc(36px * var(--ts));
    }
    :global(:root:lang(zh)) .hero__copy :global(.hero__term .term__body) {
      font-size: calc(24px * var(--ts));
    }
  }
</style>
