---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import { getCopy, getSite } from '../lib/content';
import { withBase } from '../lib/paths';
import { motionCssVars } from '../motion/params';

interface Props {
  title?: string;
  description?: string;
}

const [site, copy] = await Promise.all([getSite(), getCopy()]);
const title = Astro.props.title ?? site.meta.title;
const description = Astro.props.description ?? site.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" style={motionCssVars()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Motion only when JS runs and reduced motion isn't requested (src/styles/motion.css).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('motion');
    </script>
    <Font cssVariable="--font-code" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-pixel" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-8bit" preload />
    <!-- The hero terminal is on the first screen: without a preload its lines first wrap in the
         wider fallback and then shrink, shifting the stage and buttons (CLS ≈ 0.03). -->
    <Font cssVariable="--font-term" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.meta.keywords.length > 0 && (
      <meta name="keywords" content={site.meta.keywords.join(', ')} />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0b0f1a" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.labels.skip_link}
    </a>
    <slot />
  </body>
</html>
