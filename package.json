{
  "name": "zhic-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zhic.me v2 — Peter Chen's personal site (Astro, static, GitHub Pages)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-strict.mjs",
    "preview": "astro preview",
    "assemble": "node scripts/assemble-pages.mjs",
    "serve:site": "node scripts/serve.mjs _site",
    "preview:site": "node scripts/serve.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-colors.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "art:mono": "node scripts/make-mono-art.mjs",
    "content:check": "node scripts/check-content.mjs",
    "content:hant": "node scripts/content-hant.mjs",
    "content:stale": "node scripts/content-stale.mjs",
    "resume": "node scripts/resume.mjs",
    "changelog": "node scripts/changelog.mjs",
    "size": "size-limit && node scripts/check-js-budget.mjs",
    "lhci": "lhci autorun",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:colors && pnpm check && pnpm content:check && pnpm test && pnpm build && pnpm size && pnpm assemble && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "astro": "^7.4.7",
    "entities": "^4.5.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/fusion-pixel-12px-proportional-sc": "5.3.0",
    "@fontsource/fusion-pixel-12px-proportional-tc": "5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "fontkitten": "1.0.3",
    "globals": "^17.14.0",
    "opencc-data": "1.4.2",
    "opencc-js": "1.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "size-limit": "^14.3.0",
    "subset-font": "2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wawoff2": "2.0.1"
  }
}
